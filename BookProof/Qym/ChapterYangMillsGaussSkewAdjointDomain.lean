import BookProof.Qym.ChapterYangMillsGaussFlow
import BookProof.Qym.ChapterYangMillsGaussSkewAdjoint

/-!
# The reverse domain inclusion for the Gauss charge

`BookProof/Qym/ChapterYangMillsGaussSkewAdjoint.lean` reduces skew-adjointness of the Gauss
closure to the single inclusion `dom Ā† ≤ dom Ā`, and leaves it open because both standard
proofs need input the corpus did not carry.  This module supplies the proof from the one
input the corpus *does* carry: the flow chapter's deficiency computation
`ker(Ā† ∓ 1) = 0`.

## The argument

Let `A` be a closed, densely defined operator with `⟪A x, y⟫ = −⟪x, A y⟫` on its domain.  On a
skew operator the graph norm splits: `‖z − A z‖² = ‖z‖² + ‖A z‖²`, so `1 − A` is bounded
below by `1` and injective.

1. **`ran (1 − A)` is dense.**  A vector `w` orthogonal to the range satisfies
   `⟪z, w⟫ = ⟪A z, w⟫` for every core `z` — the deficiency equation at `+1`.  The flow
   chapter's `deficiency_one_eq_zero_of_flow` kills it, so the range's orthogonal complement
   is `⊥`.  Note the sign: it is `1 − A`, not `1 + A`, precisely because the adjoint of a
   skew operator is its negative.
2. **`ran (1 − A)` is closed in the graph-norm sense.**  If `zₙ − A zₙ → w`, then
   `‖zₙ − zₘ‖ ≤ ‖(zₙ − A zₙ) − (zₘ − A zₘ)‖` makes `zₙ` Cauchy; its limit `z` inherits
   `A z = z − w` from closedness of `A`.  Hence `1 − A` is **surjective**.
3. **von Neumann's trick.**  For `y ∈ dom A†` put `w = A† y + y` and pick `z` with
   `z − A z = w`.  Then `u = y − z` lies in `dom A†` and
   `A† u + u = (A† y + y) − (z − A z) = 0`, i.e. `A† u = −u`.  Formal adjointness turns this
   into the deficiency equation at `−1` for `u`, which the flow kills: `u = 0`.  So
   `y = z ∈ dom A`.

Composing with `skewAdjoint_iff_adjoint_domain_le` gives **`Ā† = −Ā`** for the Gauss charge,
i.e. the essential skew-adjointness Stone's theorem asks for.

## What is assumed

Only the flow chapter's hypothesis bundle (a contraction family on `L²(ℝ⁹⁹)` preserving the
core, generated by `𝒢_d` there).  Nothing else: no elliptic regularity, no Fourier estimate.
-/

namespace BookProof.Qym.GaussSkewAdjointDomain

open Filter Topology
open BookProof.Qym.GaussCasimir BookProof.BrstYmCommute BookProof.BookBrstYangMills
open BookProof.YangMillsHermite BookProof.HermiteProductCore BookProof.Qym.GaussSkew
open BookProof.Qym.GaussClosure BookProof.Qym.GaussFlow BookProof.Qym.GaussSkewAdjoint

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]

/-! ## The map `1 - A` on the domain -/

/-- The map `z ↦ z − A z` on the domain of `A`. -/
def oneSub (A : E →ₗ.[ℂ] E) : A.domain →ₗ[ℂ] E := A.domain.subtype - A.toFun

omit [CompleteSpace E] in
theorem oneSub_apply (A : E →ₗ.[ℂ] E) (z : A.domain) :
    oneSub A z = (z : E) - A z := rfl

/-! ## The graph norm of `1 - A` -/

omit [CompleteSpace E] in
/-- On a skew operator, `‖z − A z‖² = ‖A z‖² + ‖z‖²`. -/
theorem skew_norm_sub_one {A : E →ₗ.[ℂ] E}
    (hskew : ∀ x y : A.domain, inner ℂ (A x) (y : E) = -inner ℂ (x : E) (A y))
    (x : A.domain) :
    ‖(x : E) - A x‖ ^ 2 = ‖A x‖ ^ 2 + ‖(x : E)‖ ^ 2 := by
  rw [norm_sub_sq (𝕜 := ℂ)]
  have h := skew_re_inner_zero hskew x
  have hconj : inner ℂ (x : E) (A x) = (starRingEnd ℂ) (inner ℂ (A x) (x : E)) :=
    (inner_conj_symm (x : E) (A x)).symm
  have h' : RCLike.re (inner ℂ (x : E) (A x)) = 0 := by
    rw [hconj]
    exact (Complex.conj_re (inner ℂ (A x) (x : E))).trans h
  rw [h']
  ring

omit [CompleteSpace E] in
/-- Consequently `1 − A` is bounded below by `1` on the domain. -/
theorem skew_sub_one_norm_le {A : E →ₗ.[ℂ] E}
    (hskew : ∀ x y : A.domain, inner ℂ (A x) (y : E) = -inner ℂ (x : E) (A y))
    (x : A.domain) :
    ‖(x : E)‖ ≤ ‖(x : E) - A x‖ := by
  have h := skew_norm_sub_one hskew x
  have hle : ‖(x : E)‖ ^ 2 ≤ ‖(x : E) - A x‖ ^ 2 := by
    rw [h]
    have hnn : (0 : ℝ) ≤ ‖A x‖ ^ 2 := sq_nonneg _
    linarith
  have hsqrt := Real.sqrt_le_sqrt hle
  simpa [Real.sqrt_sq (norm_nonneg _)] using hsqrt

/-! ## Density of the range from the deficiency at `+1` -/

omit [CompleteSpace E] in
theorem range_oneSub_orthogonal_eq_bot {A : E →ₗ.[ℂ] E}
    (hplus : ∀ w : E, (∀ v : A.domain, inner ℂ (A v) w = inner ℂ (v : E) w) → w = 0) :
    (oneSub A).rangeᗮ = ⊥ := by
  refine (Submodule.eq_bot_iff (oneSub A).rangeᗮ).2 fun w hw => ?_
  refine hplus w fun v => ?_
  have h0 : inner ℂ (oneSub A v) w = 0 :=
    (Submodule.mem_orthogonal _ w).1 hw _ (LinearMap.mem_range_self (oneSub A) v)
  rw [oneSub_apply, inner_sub_left, sub_eq_zero] at h0
  exact h0.symm

/-- **`1 − A` is surjective**: the range is dense (deficiency at `+1`) and closed
(bounded below plus closedness of `A`). -/
theorem exists_oneSub_eq {A : E →ₗ.[ℂ] E} (hcl : A.IsClosed)
    (hskew : ∀ x y : A.domain, inner ℂ (A x) (y : E) = -inner ℂ (x : E) (A y))
    (hplus : ∀ w : E, (∀ v : A.domain, inner ℂ (A v) w = inner ℂ (v : E) w) → w = 0)
    (w : E) : ∃ z : A.domain, (z : E) - A z = w := by
  -- the range is dense
  have hden : Dense (((oneSub A).range : Submodule ℂ E) : Set E) := by
    rw [Submodule.dense_iff_topologicalClosure_eq_top,
      ← Submodule.orthogonal_orthogonal_eq_closure, range_oneSub_orthogonal_eq_bot hplus]
    simp
  obtain ⟨u, hu, hut⟩ := mem_closure_iff_seq_limit.1 (hden w)
  choose z hz using fun n => LinearMap.mem_range.1 (hu n)
  have hzt : Tendsto (fun n => oneSub A (z n)) atTop (𝓝 w) :=
    hut.congr' (Filter.Eventually.of_forall fun n => (hz n).symm)
  -- the approximating sequence of core points is Cauchy
  have hbound : ∀ a b : A.domain, ‖(a : E) - (b : E)‖ ≤ ‖oneSub A a - oneSub A b‖ := by
    intro a b
    have h := skew_sub_one_norm_le hskew (a - b)
    have hval : ((a - b : A.domain) : E) - A (a - b) = oneSub A a - oneSub A b := by
      rw [← oneSub_apply, map_sub]
    rw [hval] at h
    rwa [Submodule.coe_sub] at h
  have hcau : CauchySeq fun n => (z n : E) := by
    have hzc : CauchySeq fun n => oneSub A (z n) := hzt.cauchySeq
    rw [Metric.cauchySeq_iff] at hzc ⊢
    intro ε hε
    obtain ⟨N, hN⟩ := hzc ε hε
    exact ⟨N, fun m hm n hn =>
      lt_of_le_of_lt (by simpa [dist_eq_norm] using hbound (z m) (z n)) (hN m hm n hn)⟩
  obtain ⟨zlim, hzlim⟩ := cauchySeq_tendsto_of_complete hcau
  -- closedness of `A` upgrades the limit to a solution
  have hAt : Tendsto (fun n => A (z n)) atTop (𝓝 (zlim - w)) := by
    have hEq : ∀ n, A (z n) = (z n : E) - oneSub A (z n) := by
      intro n
      rw [oneSub_apply]
      abel
    exact (hzlim.sub hzt).congr' (Filter.Eventually.of_forall fun n => (hEq n).symm)
  have hmem : ((zlim, zlim - w) : E × E) ∈ (A.graph : Set (E × E)) := by
    refine hcl.isSeqClosed (fun n => LinearPMap.mem_graph A (z n)) ?_
    have := hzlim.prodMk hAt
    rwa [← nhds_prod_eq] at this
  obtain ⟨z', hz1, hz2⟩ := (LinearPMap.mem_graph_iff A).1 hmem
  have hzeq : (z' : E) = zlim := hz1
  refine ⟨z', ?_⟩
  rw [hz2, hzeq]
  simp

/-! ## The adjoint's domain is contained in `A`'s -/

/-- **The reverse domain inclusion.**  A closed, densely defined skew operator whose `1 − A`
has dense range (no deficiency at `+1`) and whose adjoint has no deficiency at `−1` contains
the domain of its adjoint: `dom A† ⊆ dom A`.

The hypothesis `hminus` is used exactly once, in von Neumann's argument, to kill
`A† u + u = 0`. -/
theorem exists_mem_domain_of_mem_adjoint_domain {A : E →ₗ.[ℂ] E} (hcl : A.IsClosed)
    (hd : Dense (A.domain : Set E))
    (hskew : ∀ x y : A.domain, inner ℂ (A x) (y : E) = -inner ℂ (x : E) (A y))
    (hplus : ∀ w : E, (∀ v : A.domain, inner ℂ (A v) w = inner ℂ (v : E) w) → w = 0)
    (hminus : ∀ w : E, (∀ v : A.domain, inner ℂ (A v) w = -inner ℂ (v : E) w) → w = 0)
    (y : A.adjoint.domain) :
    ∃ h : (y : E) ∈ A.domain, A.adjoint y = -(A ⟨(y : E), h⟩) := by
  -- a core point satisfying `z − A z = A† y + y`
  obtain ⟨z, hz⟩ := exists_oneSub_eq (A := A) hcl hskew hplus (A.adjoint y + (y : E))
  -- that core point is in the adjoint's domain, where the adjoint is the negative
  have hzmem : (z : E) ∈ A.adjoint.domain :=
    A.mem_adjoint_domain_of_exists (z : E) ⟨-(A z), fun x => by
      rw [inner_neg_left, hskew z x, neg_neg]⟩
  have hzval : A.adjoint ⟨(z : E), hzmem⟩ = -(A z) :=
    LinearPMap.adjoint_apply_eq hd ⟨(z : E), hzmem⟩ fun x => by
      rw [inner_neg_left, hskew z x, neg_neg]
  -- `u = y − z` satisfies `A† u = −u`
  have hu : A.adjoint (y - ⟨(z : E), hzmem⟩) = -(y - ⟨(z : E), hzmem⟩ : A.adjoint.domain) := by
    rw [LinearPMap.map_sub, hzval]
    have h0 : A.adjoint y + (y : E) = (z : E) - A z := hz.symm
    have hy : A.adjoint y = (z : E) - A z - (y : E) := by rw [← h0]; abel
    rw [hy, Submodule.coe_sub]
    abel
  -- formal adjointness turns it into the deficiency equation at `−1`
  have hdef : ∀ v : A.domain,
      inner ℂ (A v) ((y - ⟨(z : E), hzmem⟩ : A.adjoint.domain) : E)
        = -inner ℂ (v : E) ((y - ⟨(z : E), hzmem⟩ : A.adjoint.domain) : E) := by
    intro v
    have hform := (LinearPMap.adjoint_isFormalAdjoint (T := A) hd)
      (y - ⟨(z : E), hzmem⟩) v
    have h1 := congrArg (starRingEnd ℂ) hform
    rw [hu] at h1
    simp only [inner_neg_left, map_neg, inner_conj_symm] at h1
    exact h1.symm
  have hzero := hminus _ hdef
  have hyeq : (y : E) = (z : E) :=
    sub_eq_zero.1 (by simpa [Submodule.coe_sub] using hzero)
  refine ⟨hyeq ▸ z.2, ?_⟩
  have hy' : y = (⟨(z : E), hzmem⟩ : A.adjoint.domain) := Subtype.ext hyeq
  have hz' : (⟨(y : E), hyeq ▸ z.2⟩ : A.domain) = z := Subtype.ext hyeq
  calc A.adjoint y = A.adjoint ⟨(z : E), hzmem⟩ := by rw [hy']
    _ = -(A z) := hzval
    _ = -(A ⟨(y : E), hyeq ▸ z.2⟩) := by rw [hz']

/-- The reverse inclusion, as a domain statement. -/
theorem adjoint_domain_le {A : E →ₗ.[ℂ] E} (hcl : A.IsClosed)
    (hd : Dense (A.domain : Set E))
    (hskew : ∀ x y : A.domain, inner ℂ (A x) (y : E) = -inner ℂ (x : E) (A y))
    (hplus : ∀ w : E, (∀ v : A.domain, inner ℂ (A v) w = inner ℂ (v : E) w) → w = 0)
    (hminus : ∀ w : E, (∀ v : A.domain, inner ℂ (A v) w = -inner ℂ (v : E) w) → w = 0) :
    A.adjoint.domain ≤ A.domain :=
  fun y hy =>
    (exists_mem_domain_of_mem_adjoint_domain (A := A) hcl hd hskew hplus hminus ⟨y, hy⟩).1

/-- **Skew-adjointness from the two deficiency computations.** -/
theorem skewAdjoint_of_deficiency {A : E →ₗ.[ℂ] E} (hcl : A.IsClosed)
    (hd : Dense (A.domain : Set E))
    (hskew : ∀ x y : A.domain, inner ℂ (A x) (y : E) = -inner ℂ (x : E) (A y))
    (hle : A ≤ -(A.adjoint))
    (hplus : ∀ w : E, (∀ v : A.domain, inner ℂ (A v) w = inner ℂ (v : E) w) → w = 0)
    (hminus : ∀ w : E, (∀ v : A.domain, inner ℂ (A v) w = -inner ℂ (v : E) w) → w = 0) :
    SkewAdjoint A :=
  (skewAdjoint_iff_adjoint_domain_le hle).1
    (adjoint_domain_le hcl hd hskew hplus hminus)

end

/-! ## The Gauss charge -/

variable {D : Submodule ℂ (L2d 99)}

/-- The deficiency at `−1` for the Gauss core, the negative-sign companion of
`gaussPMap_polyGaussCore_deficiency_eq_zero_of_flow`. -/
theorem gaussPMap_polyGaussCore_deficiency_neg_one_eq_zero_of_flow (G : GaugeAlgebra 8)
    (d : Fin 8)
    (U : ℝ → L2d 99 →L[ℂ] L2d 99) (h0 : U 0 = 1) (hnorm : ∀ t : ℝ, ‖U t‖ ≤ 1)
    (hmaps : ∀ (t : ℝ) (v : (gaussPMap G d (coreRepPoly 99)).domain),
      U t (v : L2d 99) ∈ (gaussPMap G d (coreRepPoly 99)).domain)
    (hgen : ∀ (v : (gaussPMap G d (coreRepPoly 99)).domain) (t : ℝ),
      HasDerivAt (fun s : ℝ => U s (v : L2d 99))
        ((gaussPMap G d (coreRepPoly 99)) ⟨U t (v : L2d 99), hmaps t v⟩) t)
    (w : L2d 99)
    (hw : ∀ v : (gaussPMap G d (coreRepPoly 99)).domain,
      inner ℂ ((gaussPMap G d (coreRepPoly 99)) v) w = -inner ℂ (v : L2d 99) w) : w = 0 :=
  deficiency_neg_one_eq_zero_of_flow polyGaussCore_dense
    (gaussPMap G d (coreRepPoly 99)).toFun U h0 hnorm hmaps hgen hw

/-- **The Gauss closure is skew-adjoint**, given the residual-rotation flow.  The two
deficiency spaces of the adjoint are trivial by the flow chapter; the range argument above
turns that into `dom Ā† ⊆ dom Ā` and hence `Ā† = −Ā`. -/
theorem gaussPMap_closure_skewAdjoint_of_flow (G : GaugeAlgebra 8) (d : Fin 8)
    (U : ℝ → L2d 99 →L[ℂ] L2d 99) (h0 : U 0 = 1) (hnorm : ∀ t : ℝ, ‖U t‖ ≤ 1)
    (hmaps : ∀ (t : ℝ) (v : (gaussPMap G d (coreRepPoly 99)).domain),
      U t (v : L2d 99) ∈ (gaussPMap G d (coreRepPoly 99)).domain)
    (hgen : ∀ (v : (gaussPMap G d (coreRepPoly 99)).domain) (t : ℝ),
      HasDerivAt (fun s : ℝ => U s (v : L2d 99))
        ((gaussPMap G d (coreRepPoly 99)) ⟨U t (v : L2d 99), hmaps t v⟩) t) :
    SkewAdjoint (gaussPMap G d (coreRepPoly 99)).closure := by
  -- on the core inside the closure, the eigenvalue equation is the core's
  have hcore : ∀ (w : L2d 99) (c : ℂ),
      (∀ v : (gaussPMap G d (coreRepPoly 99)).closure.domain,
        inner ℂ ((gaussPMap G d (coreRepPoly 99)).closure v) w
          = c * inner ℂ (v : L2d 99) w) →
      ∀ x : (gaussPMap G d (coreRepPoly 99)).domain,
        inner ℂ ((gaussPMap G d (coreRepPoly 99)) x) w = c * inner ℂ (x : L2d 99) w := by
    intro w c hw x
    have h := hw
      (Submodule.inclusion (LinearPMap.le_closure (gaussPMap G d (coreRepPoly 99))).1 x)
    rwa [(LinearPMap.apply_comp_inclusion (LinearPMap.le_closure _) x).symm] at h
  refine skewAdjoint_of_deficiency (gaussPMap_closure_isClosed G d (coreRepPoly 99)
      polyGaussCore_dense)
    (gaussPMap_closure_domain_dense G d (coreRepPoly 99) polyGaussCore_dense)
    (fun x y => gaussPMap_closure_skew G d (coreRepPoly 99) polyGaussCore_dense x y)
    (gaussPMap_closure_le_negAdjoint G d (coreRepPoly 99) polyGaussCore_dense) ?_ ?_
  · intro w hw
    refine gaussPMap_polyGaussCore_deficiency_eq_zero_of_flow G d U h0 hnorm hmaps hgen w ?_
    intro v
    simpa using hcore w 1 (fun u => by simpa using hw u) v
  · intro w hw
    refine gaussPMap_polyGaussCore_deficiency_neg_one_eq_zero_of_flow G d U h0 hnorm hmaps hgen
      w ?_
    intro v
    simpa using hcore w (-1) (fun u => by simpa using hw u) v

end BookProof.Qym.GaussSkewAdjointDomain
