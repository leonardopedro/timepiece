import BookProof.Qym.ChapterYangMillsGaussFlow
import BookProof.Qym.ChapterYangMillsGaussSkewAdjointDomain
import BookProof.ChapterQuadraticRotationEsa

/-!
# The residual colour rotation: matrix, flow and its action on `L²(ℝ⁹⁹)`

`BookProof/Qym/ChapterYangMillsGaussFlow.lean` computes the deficiency spaces of the Gauss
constraint from a one-parameter family of contractions `U t` preserving the core and
generated by `𝒢_d` there.  This module builds that family from the concrete rotation of
`ℝ⁹⁹`, leaving a single analytic input (the generator identity) as a hypothesis.

## The matrix

The Gauss vector field is linear in the coordinates: `ymGaussVec G d m` is a sum of terms
`c • X i` with `c` real (`ymGaussVec_split`).  Its matrix `gaussMat G d` has entries

`(gaussMat G d) m j` = the coefficient of `X j` in `ymGaussVec G d m`,

and `ymGaussVec_eq_sum_gaussMat` is the identity `v_m = Σ_j M_{m j} x_j` read in the
polynomial ring.  `sum_X_ymGaussVec` (`Σ_m x_m v_m = 0`) is exactly the statement that `M`
is antisymmetric, which is `gaussMat_transpose` below.

## The flow

For an antisymmetric `M`, `E t = exp (t • M)` is a one-parameter group of orthogonal
matrices:

* `gaussFlow_zero`, `gaussFlow_add` — `E 0 = 1` and `E (s + t) = E s * E t`;
* `gaussFlow_transpose_mul` — `(E t)ᵀ * E t = 1`, hence `‖E t x‖ = ‖x‖`;
* `gaussFlow_hasDerivAt` — `E'(t) = -M * E t`.

The rotation acts on functions by `x ↦ E t x`.  Because it preserves the Gaussian measure,
`gaussFlowOp t f = f ∘ E t` is a linear isometry of `L²(ℝ⁹⁹)`
(`gaussFlowOp_zero`, `gaussFlowOp_norm_le`), and on the Gauss–polynomial core it is the
substitution `rotPoly (E t)`, so it preserves the core and every `CoreRep` core
(`gaussFlowOp_pgLp`, `gaussFlowOp_mem_core`, `gaussFlowOp_mem_domain`).

## What is left

Only the generator identity enters as a hypothesis: that `t ↦ gaussFlowOp t v` is
differentiable at every `t` with derivative `𝒢_d (gaussFlowOp t v)`.  It is the statement
that `𝒢_d` is the derivative at `0` of the substitution `rotPoly (E t)`, and it is not
proved here.  Everything else in the flow bundle of `ChapterYangMillsGaussFlow` is proved
in this module, so `gaussPMap_closure_skewAdjoint_of_rotation` derives the skew-adjointness
of the closed Gauss charge from that one identity.
-/

namespace BookProof.Qym.GaussRotationFlow

open Matrix MvPolynomial MeasureTheory
open scoped Norms.Operator
open BookProof.Qym.GaussCasimir BookProof.BrstYmCommute BookProof.BookBrstYangMills
open BookProof.YangMillsHermite BookProof.HermiteProductCore BookProof.Qym.GaussSkew
open BookProof.Qym.GaussClosure BookProof.Qym.GaussSkewAdjoint
open BookProof.Qym.GaussSkewAdjointDomain
open BookProof.QuadraticRotation

noncomputable section

/-! ## The matrix of the Gauss vector field -/

/-- **The matrix of the Gauss vector field**: the coefficient of `X j` in `ymGaussVec G d m`,
with the two index blocks written out.  Defined blockwise so that the linear identity
`ymGaussVec G d m = Σ_j M_{m j} • X j` is a reindexing rather than a coefficient
computation. -/
def gaussMat (G : GaugeAlgebra 8) (d : Fin 8) : Matrix (Fin 99) (Fin 99) ℝ :=
  fun m j =>
    (∑ p : Fin 3 × Fin 8,
      if idxA p.1 p.2 = m then
        (∑ g : Fin 8, if idxA p.1 g = j then G.f p.2 g d else 0) else 0)
    + ∑ p : Fin 3 × Fin 3 × Fin 8,
        if idxD p.1 p.2.1 p.2.2 = m then
          (∑ g : Fin 8, if idxD p.1 p.2.1 g = j then G.f p.2.2 g d else 0) else 0

/-! ## Reindexing a block of linear terms -/

/-- **A sum of linear monomials as a column combination.**  A finite family
`c p g • X (f p g)` collects, in coordinate `j`, the sum of those coefficients whose index
maps to `j`. -/
theorem sum_smul_X_reindex {ι : Type*} [Fintype ι] (f : ι → Fin 99) (c : ι → ℝ) :
    (∑ i, ((c i : ℝ) : ℂ) • (X (f i) : MvPolynomial (Fin 99) ℂ))
      = ∑ j, (((∑ i, if f i = j then c i else (0 : ℝ)) : ℝ) : ℂ)
          • (X j : MvPolynomial (Fin 99) ℂ) := by
  have hR : (∑ j, (((∑ i, if f i = j then c i else (0 : ℝ)) : ℝ) : ℂ)
        • (X j : MvPolynomial (Fin 99) ℂ))
      = ∑ j, ∑ i, (((if f i = j then c i else (0 : ℝ)) : ℝ) : ℂ)
          • (X j : MvPolynomial (Fin 99) ℂ) := by
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [← Finset.sum_smul]
    congr 1
    push_cast
    rfl
  rw [hR, Finset.sum_comm]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Finset.sum_eq_single (f i)]
  · rw [if_pos rfl]
  · intro j _ hj
    rw [if_neg (Ne.symm hj), Complex.ofReal_zero, zero_smul]
  · intro h
    exact absurd (Finset.mem_univ _) h

/-- **One index block of the Gauss vector field**, reindexed by coordinate.  `s` is the
coordinate of the block element itself, `f` the coordinate it differentiates, and `c` the
structure constant. -/
theorem block_eq {ι : Type*} [Fintype ι] (s : ι → Fin 99) (f : ι → Fin 8 → Fin 99)
    (c : ι → Fin 8 → ℝ) (m : Fin 99) :
    (∑ p : ι, if s p = m then
        (∑ g : Fin 8, ((c p g : ℝ) : ℂ) • (X (f p g) : MvPolynomial (Fin 99) ℂ))
      else 0)
      = ∑ j, (((∑ p : ι, if s p = m then
            (∑ g : Fin 8, if f p g = j then c p g else (0 : ℝ)) else 0) : ℝ) : ℂ)
          • (X j : MvPolynomial (Fin 99) ℂ) := by
  have hL : (∑ p : ι, if s p = m then
        (∑ g : Fin 8, ((c p g : ℝ) : ℂ) • (X (f p g) : MvPolynomial (Fin 99) ℂ))
      else 0)
      = ∑ i : ι × Fin 8,
          (((if s i.1 = m then c i.1 i.2 else (0 : ℝ)) : ℝ) : ℂ)
            • (X (f i.1 i.2) : MvPolynomial (Fin 99) ℂ) := by
    rw [Fintype.sum_prod_type]
    refine Finset.sum_congr rfl fun p _ => ?_
    by_cases h : s p = m
    · rw [if_pos h]
      exact (Finset.sum_congr rfl fun g _ => by rw [if_pos h]).symm
    · rw [if_neg h]
      refine (Finset.sum_eq_zero fun g _ => ?_).symm
      rw [if_neg h, Complex.ofReal_zero, zero_smul]
  rw [hL, sum_smul_X_reindex]
  have hcoef : ∀ j : Fin 99,
      (∑ i : ι × Fin 8, (if f i.1 i.2 = j then
          (if s i.1 = m then c i.1 i.2 else (0 : ℝ)) else 0))
      = ∑ p : ι, if s p = m then
          (∑ g : Fin 8, if f p g = j then c p g else (0 : ℝ)) else 0 := by
    intro j
    rw [Fintype.sum_prod_type]
    refine Finset.sum_congr rfl fun p _ => ?_
    by_cases h : s p = m
    · rw [if_pos h]
      refine Finset.sum_congr rfl fun g _ => ?_
      by_cases h2 : f p g = j
      · simp [h2, h]
      · simp [h2]
    · rw [if_neg h]
      symm
      simp [h]
  simp only [hcoef]

/-! ## The linear representation and antisymmetry -/

/-- **The Gauss vector field is the matrix acting on the coordinates**:
`v_m = Σ_j M_{m j} x_j`. -/
theorem ymGaussVec_eq_sum_gaussMat (G : GaugeAlgebra 8) (d : Fin 8) (m : Fin 99) :
    ymGaussVec G d m
      = ∑ j : Fin 99, (((gaussMat G d m j : ℝ) : ℂ)) • (X j : MvPolynomial (Fin 99) ℂ) := by
  have hA := block_eq (ι := Fin 3 × Fin 8)
    (s := fun p => idxA p.1 p.2) (f := fun p g => idxA p.1 g)
    (c := fun p g => G.f p.2 g d) m
  have hD := block_eq (ι := Fin 3 × Fin 3 × Fin 8)
    (s := fun p => idxD p.1 p.2.1 p.2.2) (f := fun p g => idxD p.1 p.2.1 g)
    (c := fun p g => G.f p.2.2 g d) m
  rw [ymGaussVec_split, hA, hD, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [gaussMat, Complex.ofReal_add, add_smul]

/-! ## The quadratic form and antisymmetry -/

/-- The derivative of a linear form `Σ_l a_l • X_l`. -/
theorem pderiv_sum_smul_X {d : ℕ} (a : Fin d → ℂ) (i : Fin d) :
    pderiv i (∑ l, a l • (X l : MvPolynomial (Fin d) ℂ)) = C (a i) := by
  rw [map_sum, Finset.sum_eq_single i]
  · rw [smul_eq_C_mul, pderiv_mul, pderiv_C, zero_mul, zero_add, pderiv_X_self, mul_one]
  · intro l _ hl
    rw [smul_eq_C_mul, pderiv_mul, pderiv_C, zero_mul, zero_add,
      pderiv_X_of_ne hl, mul_zero]
  · intro h
    exact absurd (Finset.mem_univ _) h

/-- The mixed second derivative of the quadratic form `Σ_{k,l} M_{k l} x_k x_l`. -/
theorem pderiv_pderiv_quad {d : ℕ} (M : Fin d → Fin d → ℂ) (m j : Fin d) :
    pderiv m (pderiv j (∑ k, (X k : MvPolynomial (Fin d) ℂ)
        * (∑ l, M k l • (X l : MvPolynomial (Fin d) ℂ))))
      = C (M j m + M m j) := by
  have hstep : pderiv j (∑ k, (X k : MvPolynomial (Fin d) ℂ)
      * (∑ l, M k l • (X l : MvPolynomial (Fin d) ℂ)))
      = (∑ l, M j l • (X l : MvPolynomial (Fin d) ℂ))
        + ∑ k, C (M k j) * (X k : MvPolynomial (Fin d) ℂ) := by
    rw [map_sum]
    have hmove : (∑ k, pderiv j ((X k : MvPolynomial (Fin d) ℂ)
        * (∑ l, M k l • (X l : MvPolynomial (Fin d) ℂ))))
        = (∑ k, pderiv j (X k) * (∑ l, M k l • (X l : MvPolynomial (Fin d) ℂ)))
          + ∑ k, (X k : MvPolynomial (Fin d) ℂ) * C (M k j) := by
      rw [← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun k _ => by
        rw [pderiv_mul, pderiv_sum_smul_X]
    rw [hmove]
    have hfirst : (∑ k, pderiv j (X k) * (∑ l, M k l • (X l : MvPolynomial (Fin d) ℂ)))
        = ∑ l, M j l • (X l : MvPolynomial (Fin d) ℂ) := by
      rw [Finset.sum_eq_single j]
      · rw [pderiv_X_self, one_mul]
      · intro k _ hk
        rw [pderiv_X_of_ne hk, zero_mul]
      · intro h
        exact absurd (Finset.mem_univ _) h
    rw [hfirst]
    congr 1
    exact Finset.sum_congr rfl fun k _ => mul_comm _ _
  rw [hstep, map_add]
  have hconst : pderiv m (∑ k, C (M k j) * (X k : MvPolynomial (Fin d) ℂ))
      = C (M m j) := by
    rw [map_sum, Finset.sum_eq_single m]
    · rw [pderiv_mul, pderiv_C, zero_mul, zero_add, pderiv_X_self, mul_one]
    · intro k _ hk
      rw [pderiv_mul, pderiv_C, zero_mul, zero_add, pderiv_X_of_ne hk, mul_zero]
    · intro h
      exact absurd (Finset.mem_univ _) h
  rw [pderiv_sum_smul_X, hconst, ← map_add]

/-- **`M` is antisymmetric.**  The identity `Σ_m x_m v_m = 0` reads as `xᵀ M x = 0`; the
coefficient of `x_m x_j` in the mixed second derivative of that quadratic form is
`M_{j m} + M_{m j}`. -/
theorem gaussMat_antisymm (G : GaugeAlgebra 8) (d : Fin 8) (m j : Fin 99) :
    gaussMat G d j m = -gaussMat G d m j := by
  have hq : (∑ k : Fin 99, (X k : YmPoly)
      * (∑ l : Fin 99, (((gaussMat G d k l : ℝ) : ℂ)) • (X l : YmPoly))) = 0 := by
    rw [← sum_X_ymGaussVec G d]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [ymGaussVec_eq_sum_gaussMat]
  have hzero : pderiv m (pderiv j (∑ k : Fin 99, (X k : YmPoly)
      * (∑ l : Fin 99, (((gaussMat G d k l : ℝ) : ℂ)) • (X l : YmPoly)))) = 0 := by
    rw [hq]
    simp
  have hquad := pderiv_pderiv_quad (d := 99)
    (fun k l => ((gaussMat G d k l : ℝ) : ℂ)) m j
  rw [hzero] at hquad
  have hC : ((gaussMat G d j m : ℝ) : ℂ) + ((gaussMat G d m j : ℝ) : ℂ) = 0 :=
    MvPolynomial.C_eq_zero.mp hquad.symm
  have hR : gaussMat G d j m + gaussMat G d m j = 0 := by
    have h := congrArg Complex.re hC
    simpa using h
  linarith

/-- The transpose of the Gauss matrix is its negative. -/
theorem gaussMat_transpose (G : GaugeAlgebra 8) (d : Fin 8) :
    Matrix.transpose (gaussMat G d) = -gaussMat G d := by
  ext m j
  rw [Matrix.transpose_apply, Matrix.neg_apply]
  exact gaussMat_antisymm G d m j

/-! ## The flow `E(t) = exp (t M)` and its orthogonality -/

/-- **The residual colour rotation**: `E(t) = e^{-tM}`, the matrix exponential of the Gauss
generator with the sign of the flow of the vector field `v = Mx` (a positive time moves the
point along `v`, so the *function* is pulled back by `e^{-tM}`). -/
def gaussFlow (G : GaugeAlgebra 8) (d : Fin 8) (t : ℝ) : Matrix (Fin 99) (Fin 99) ℝ :=
  NormedSpace.exp ((-t) • gaussMat G d)

@[simp] theorem gaussFlow_zero (G : GaugeAlgebra 8) (d : Fin 8) :
    gaussFlow G d 0 = 1 := by
  simp [gaussFlow]

/-- The flow is a one-parameter group. -/
theorem gaussFlow_add (G : GaugeAlgebra 8) (d : Fin 8) (s t : ℝ) :
    gaussFlow G d s * gaussFlow G d t = gaussFlow G d (s + t) := by
  have hcomm : Commute ((-s) • gaussMat G d) ((-t) • gaussMat G d) :=
    ((Commute.refl (gaussMat G d)).smul_left (-s)).smul_right (-t)
  simp only [gaussFlow]
  calc NormedSpace.exp ((-s) • gaussMat G d) * NormedSpace.exp ((-t) • gaussMat G d)
      = NormedSpace.exp ((-s) • gaussMat G d + (-t) • gaussMat G d) :=
        (NormedSpace.exp_add_of_commute hcomm).symm
    _ = NormedSpace.exp ((-(s + t)) • gaussMat G d) := by
        rw [← add_smul]
        congr 1
        linarith

/-- **The flow is orthogonal**: `(E t)ᵀ * E t = 1`. -/
theorem gaussFlow_transpose_mul (G : GaugeAlgebra 8) (d : Fin 8) (t : ℝ) :
    Matrix.transpose (gaussFlow G d t) * gaussFlow G d t = 1 := by
  have hM : Matrix.transpose ((-t) • gaussMat G d) = -((-t) • gaussMat G d) := by
    rw [Matrix.transpose_smul, gaussMat_transpose, smul_neg]
  have htrans : Matrix.transpose (gaussFlow G d t)
      = NormedSpace.exp (Matrix.transpose ((-t) • gaussMat G d)) := by
    rw [gaussFlow]
    exact (Matrix.exp_transpose ((-t) • gaussMat G d)).symm
  rw [htrans, hM]
  change NormedSpace.exp (-((-t) • gaussMat G d)) * NormedSpace.exp ((-t) • gaussMat G d) = 1
  rw [← NormedSpace.exp_add_of_commute
    (Commute.neg_left (Commute.refl ((-t) • gaussMat G d))), neg_add_cancel, NormedSpace.exp_zero]

/-- **The flow's derivative** is minus left multiplication by the generator. -/
theorem gaussFlow_hasDerivAt (G : GaugeAlgebra 8) (d : Fin 8) (t : ℝ) :
    HasDerivAt (fun s : ℝ => gaussFlow G d s) (-(gaussMat G d) * gaussFlow G d t) t := by
  simpa only [gaussFlow, smul_neg, neg_smul] using
    hasDerivAt_exp_smul_const' (-(gaussMat G d)) t

/-- The flow acting on a fixed vector is differentiable, with derivative the generator. -/
theorem gaussFlow_mulVec_hasDerivAt (G : GaugeAlgebra 8) (d : Fin 8) (x : Fin 99 → ℝ)
    (t : ℝ) :
    HasDerivAt (fun s : ℝ => gaussFlow G d s *ᵥ x)
      (((-(gaussMat G d)) * gaussFlow G d t) *ᵥ x) t := by
  rw [hasDerivAt_pi]
  intro i
  have hfun : (fun s : ℝ => (gaussFlow G d s *ᵥ x) i)
      = fun s : ℝ => ∑ j : Fin 99, gaussFlow G d s i j * x j := by
    funext s
    simp [Matrix.mulVec, dotProduct]
  rw [hfun]
  have hentry : ∀ j : Fin 99, HasDerivAt (fun s : ℝ => gaussFlow G d s i j * x j)
      (((-(gaussMat G d)) * gaussFlow G d t) i j * x j) t := fun j =>
    ((hasDerivAt_pi.1 ((hasDerivAt_pi.1 (gaussFlow_hasDerivAt G d t)) i)) j).mul_const (x j)
  exact HasDerivAt.fun_sum (u := Finset.univ) fun j _ => hentry j

/-! ## The rotation as isometries of `ℝ⁹⁹` and of `L²(ℝ⁹⁹)` -/

/-- The orthogonal flow as a linear isometry of `ℝ⁹⁹`. -/
def gaussFlowIso (G : GaugeAlgebra 8) (d : Fin 8) (t : ℝ) :
    Vd 99 ≃ₗᵢ[ℝ] Vd 99 :=
  rotIso (gaussFlow_transpose_mul G d t)

/-- At `t = 0` the rotation is the identity. -/
theorem gaussFlowIso_apply_zero (G : GaugeAlgebra 8) (d : Fin 8) (x : Vd 99) :
    gaussFlowIso G d 0 x = x := by
  change rotIso (gaussFlow_transpose_mul G d 0) x = x
  rw [rotIso_apply, gaussFlow_zero]
  ext i
  simp [rotLin, Matrix.one_apply]

/-- **The flow on `L²(ℝ⁹⁹)`**: composition with the rotation.  It is a linear isometry
because the rotation preserves Lebesgue measure. -/
def gaussFlowOp (G : GaugeAlgebra 8) (d : Fin 8) (t : ℝ) :
    L2d 99 →ₗᵢ[ℂ] L2d 99 :=
  Lp.compMeasurePreservingₗᵢ ℂ (gaussFlowIso G d t)
    (gaussFlowIso G d t).measurePreserving

/-- Pointwise description of the flow on `L²`. -/
theorem gaussFlowOp_coeFn (G : GaugeAlgebra 8) (d : Fin 8) (t : ℝ) (f : L2d 99) :
    (gaussFlowOp G d t f : Vd 99 → ℂ)
      =ᵐ[volume] fun x => (f : Vd 99 → ℂ) (gaussFlowIso G d t x) :=
  Lp.coeFn_compMeasurePreserving f (gaussFlowIso G d t).measurePreserving

/-- **The flow is the substitution `rotPoly` on the Gauss–polynomial core.** -/
theorem gaussFlowOp_pgLp (G : GaugeAlgebra 8) (d : Fin 8) (t : ℝ)
    (p : MvPolynomial (Fin 99) ℂ) :
    gaussFlowOp G d t (pgLp p) = pgLp (rotPoly (gaussFlow G d t) p) := by
  refine Lp.ext ?_
  have h1 := gaussFlowOp_coeFn G d t (pgLp p)
  have h2 : (fun x => (pgLp p : Vd 99 → ℂ) (gaussFlowIso G d t x))
      =ᵐ[volume] fun x => pgFun p (gaussFlowIso G d t x) :=
    (gaussFlowIso G d t).measurePreserving.quasiMeasurePreserving.ae_eq (pgLp_coeFn p)
  have h3 : (fun x => pgFun p (gaussFlowIso G d t x))
      =ᵐ[volume] fun x => pgFun (rotPoly (gaussFlow G d t) p) x :=
    Filter.Eventually.of_forall fun x =>
      (pgFun_rotPoly (gaussFlow_transpose_mul G d t) p x).symm
  have h4 : (fun x => pgFun (rotPoly (gaussFlow G d t) p) x)
      =ᵐ[volume] (pgLp (rotPoly (gaussFlow G d t) p) : Vd 99 → ℂ) :=
    (pgLp_coeFn (rotPoly (gaussFlow G d t) p)).symm
  exact h1.trans (h2.trans (h3.trans h4))

/-- The flow is the identity at `t = 0`. -/
theorem gaussFlowOp_zero (G : GaugeAlgebra 8) (d : Fin 8) :
    (gaussFlowOp G d 0).toContinuousLinearMap = ContinuousLinearMap.id ℂ (L2d 99) := by
  refine ContinuousLinearMap.ext fun f => ?_
  refine Lp.ext ?_
  have h1 := gaussFlowOp_coeFn G d 0 f
  have h2 : (fun x : Vd 99 => (f : Vd 99 → ℂ) (gaussFlowIso G d 0 x))
      = (f : Vd 99 → ℂ) := by
    funext x
    rw [gaussFlowIso_apply_zero]
  simpa [h2] using h1

/-- The flow's operator norm is at most one. -/
theorem gaussFlowOp_norm_le (G : GaugeAlgebra 8) (d : Fin 8) (t : ℝ) :
    ‖(gaussFlowOp G d t).toContinuousLinearMap‖ ≤ 1 := by
  refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun f => ?_
  rw [LinearIsometry.coe_toContinuousLinearMap, LinearIsometry.norm_map, one_mul]

/-- **The flow preserves the core**: it maps `pgLp p` to `pgLp (rotPoly p)`. -/
theorem gaussFlowOp_mem_core (G : GaugeAlgebra 8) (d : Fin 8) (t : ℝ) {v : L2d 99}
    (hv : v ∈ polyGaussCore (d := 99)) :
    gaussFlowOp G d t v ∈ polyGaussCore (d := 99) := by
  obtain ⟨p, hp⟩ := hv
  rw [← hp]
  change gaussFlowOp G d t (pgLp p) ∈ polyGaussCore (d := 99)
  rw [gaussFlowOp_pgLp]
  exact pgLp_mem_core _

/-- The flow preserves the core presented by a `CoreRep`. -/
theorem gaussFlowOp_mem_domain (G : GaugeAlgebra 8) (d : Fin 8)
    {D : Submodule ℂ (L2d 99)} (Φ : CoreRep 99 D) (t : ℝ) {v : L2d 99} (hv : v ∈ D) :
    gaussFlowOp G d t v ∈ D := by
  set p : MvPolynomial (Fin 99) ℂ := Φ.equiv.symm ⟨v, hv⟩ with hp
  have hcoe : v = pgLp p := by
    have h := Φ.coe_symm (⟨v, hv⟩ : D)
    simpa [hp] using h
  have hpg : gaussFlowOp G d t v = pgLp (rotPoly (gaussFlow G d t) p) := by
    conv_lhs => rw [hcoe]
    exact gaussFlowOp_pgLp G d t p
  rw [hpg, ← Φ.coe_equiv (rotPoly (gaussFlow G d t) p)]
  exact (Φ.equiv _).2

/-- **The flow bundle of the Gauss constraint, from the rotation.**  Everything the flow
chapter assumes is proved here except the generator identity `hgen`. -/
theorem gaussPMap_closure_skewAdjoint_of_rotation (G : GaugeAlgebra 8) (d : Fin 8)
    (hgen : ∀ (v : (gaussPMap G d (coreRepPoly 99)).domain) (t : ℝ),
      HasDerivAt (fun s : ℝ => gaussFlowOp G d s (v : L2d 99))
        ((gaussPMap G d (coreRepPoly 99))
          ⟨gaussFlowOp G d t (v : L2d 99),
            gaussFlowOp_mem_core G d t v.2⟩) t) :
    SkewAdjoint (gaussPMap G d (coreRepPoly 99)).closure :=
  gaussPMap_closure_skewAdjoint_of_flow G d
    (fun t => (gaussFlowOp G d t).toContinuousLinearMap)
    (by simpa using gaussFlowOp_zero G d) (fun t => gaussFlowOp_norm_le G d t)
    (fun t v => gaussFlowOp_mem_core G d t v.2) (fun v t => hgen v t)

end

end BookProof.Qym.GaussRotationFlow
