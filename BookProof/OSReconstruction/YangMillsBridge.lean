import Mathlib
import BookProof.OSReconstruction.PhysicalSpace
import BookProof.OSReconstruction.HilbertSpace
import BookProof.OSReconstruction.ReflectionKernel
import Definitions.Def_YangMills

/-!
# Bridge: the platform's `YangMills.IsReflectionPositive` and the state-level OS form

`cftproof.md`, Phase 3.3–4.  The corpus proves reflection positivity, OS reconstruction and the
physical Hilbert space for a **state on the observable algebra**:

* `ReflectionPositivity.IsReflectionPositive ω` — `ω(θF · F) ≥ 0` for every observable `F`;
* `OSReconstruction.osBilin ω F G = ω(θF · G)` — the OS form, symmetric
  (`osForm_symm'`), positive semidefinite (`osForm_self_nonneg`) and Cauchy–Schwarz
  (`osForm_cauchy_schwarz`).

The prove2.me mission for Jaffe–Witten's Yang–Mills problem states the same axiom at the level of
a **continuum correlation functional on dyadic loops** (`Definitions.Def_YangMills`):

```
YangMills.IsReflectionPositive (W : List (Loop d) → ℂ)
```

i.e. for coefficients `c : Fin n → ℂ` and admissible families `A i` of loops of strictly positive
time coordinate, the number `∑ᵢ ∑ⱼ conj(cᵢ) cⱼ W(θAᵢ ++ Aⱼ)` is real and nonnegative.

This module is the dictionary between the two.  A *loop observable* `Wobs : Loop d → Observable`
assigns to each dyadic loop the function `U ↦ tr ρ(U_γ)` on configurations; a family `A` of loops
gives the product observable `loopProd Wobs A = ∏_{γ ∈ A} Wobs γ`, and the correlation functional
is that product read through the state,
`W A = ω(∏_{γ ∈ A} Wobs γ)`.

## Contents

* `loopProd`, `loopProd_append`, and
  **`thetaObs_loopProd`** — `θ` of a product over a family is the product over the *reflected*
  family, provided `θ (Wobs γ) = Wobs γ.reflect` (the lattice fact
  `W_{θγ}(U) = conj (W_γ(θU))`);
* `osBilin_gram` — the Gram identity
  `∑ᵢ ∑ⱼ xᵢ xⱼ ⟨Gᵢ, Gⱼ⟩ = ⟨∑ᵢ xᵢ Gᵢ, ∑ⱼ xⱼ Gⱼ⟩`, and `osBilin_gram_nonneg` — it is
  nonnegative on positive-time observables, which is reflection positivity applied to a
  linear combination;
* **`complex_sum_quadform`** — for a symmetric real matrix `B` and complex coefficients `c`,
  `∑ᵢ ∑ⱼ conj(cᵢ) cⱼ Bᵢⱼ = (∑ xᵢxⱼBᵢⱼ + ∑ yᵢyⱼBᵢⱼ : ℝ)` with `x = Re c`, `y = Im c`: the
  imaginary part cancels because `B` is symmetric;
* **`isReflectionPositive_yangMills`** — the platform's `IsReflectionPositive` for
  `A ↦ ω(∏_{γ ∈ A} Wobs γ)`, deduced from state-level OS positivity on `𝔄₊`;
* **`isReflectionPositiveOn_loopProd`** — the converse for a single family: the platform's axiom
  gives back our state-level positivity on products of loops.

## Boundary

The passage in the other direction for *several* families would need the platform axiom together
with positivity of the Gram matrix of a multi-family family — one extra index — and is not needed
here.  What is *not* claimed: that `𝔄₊` of `ReflectionPositivity.HalfSpaceAlgebra` (real-valued
fields on the Balaban lattice) is literally the algebra generated by Wilson loops of
`Definitions.Def_YangMills` (group-valued links on a different lattice).  The bridge is at the
level of the *statements*: `Wobs` and the positivity of `loopProd` on `𝔄₊` are hypotheses, exactly
the two inputs the OS axiom needs.
-/

namespace BookProof.OSReconstruction

open BookProof.ReflectionPositivity

noncomputable section

variable {d : ℕ} [NeZero d]

/-! ## The observable of a family of loops -/

/-- The product observable of a family of loops: `∏_{γ ∈ A} Wobs γ`. -/
def loopProd (Wobs : YangMills.Loop d → Observable) (A : List (YangMills.Loop d)) : Observable :=
  (A.map Wobs).prod

@[simp]
theorem loopProd_nil (Wobs : YangMills.Loop d → Observable) : loopProd Wobs [] = 1 := by
  simp [loopProd]

theorem loopProd_cons (Wobs : YangMills.Loop d → Observable) (γ : YangMills.Loop d)
    (A : List (YangMills.Loop d)) :
    loopProd Wobs (γ :: A) = Wobs γ * loopProd Wobs A := by
  simp [loopProd]

theorem loopProd_append (Wobs : YangMills.Loop d → Observable) (A B : List (YangMills.Loop d)) :
    loopProd Wobs (A ++ B) = loopProd Wobs A * loopProd Wobs B := by
  simp [loopProd, List.map_append]

/-- **`θ` of a product over a family is the product over the reflected family**, given that `θ`
exchanges a loop observable with the observable of the reflected loop. -/
theorem thetaObs_loopProd (Wobs : YangMills.Loop d → Observable)
    (hθ : ∀ γ : YangMills.Loop d, thetaObs (Wobs γ) = Wobs γ.reflect)
    (A : List (YangMills.Loop d)) :
    thetaObs (loopProd Wobs A) = loopProd Wobs (A.map YangMills.Loop.reflect) := by
  induction A with
  | nil => simp [thetaObs_one]
  | cons γ A ih =>
    rw [loopProd_cons, List.map_cons, loopProd_cons, thetaObs_mul, hθ γ, ih]

/-! ## The Gram form of the OS bilinear form -/

/-- **The Gram identity** for the OS form. -/
theorem osBilin_gram (ω : LinearFunctional) {ι : Type*} (s : Finset ι) (c : ι → ℝ)
    (G : ι → Observable) :
    (∑ i ∈ s, ∑ j ∈ s, c i * c j * osBilin ω (G i) (G j)) =
      osBilin ω (∑ i ∈ s, c i • G i) (∑ j ∈ s, c j • G j) := by
  have hright : ∀ F : Observable,
      osBilin ω F (∑ j ∈ s, c j • G j) = ∑ j ∈ s, c j * osBilin ω F (G j) := by
    intro F
    rw [← osBilinMap_apply, map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_smul, smul_eq_mul, osBilinMap_apply]
  have hleft : ∀ F : Observable,
      osBilin ω (∑ i ∈ s, c i • G i) F = ∑ i ∈ s, c i * osBilin ω (G i) F := by
    intro F
    rw [← osBilinMap_apply, map_sum, LinearMap.sum_apply]
    exact Finset.sum_congr rfl fun i _ => by
      rw [map_smul, LinearMap.smul_apply, smul_eq_mul, osBilinMap_apply]
  refine Eq.symm ?_
  calc osBilin ω (∑ i ∈ s, c i • G i) (∑ j ∈ s, c j • G j)
      = ∑ j ∈ s, c j * osBilin ω (∑ i ∈ s, c i • G i) (G j) := hright _
    _ = ∑ j ∈ s, c j * (∑ i ∈ s, c i * osBilin ω (G i) (G j)) := by
          exact Finset.sum_congr rfl fun j _ => by rw [hleft]
    _ = ∑ j ∈ s, ∑ i ∈ s, c j * (c i * osBilin ω (G i) (G j)) := by
          exact Finset.sum_congr rfl fun j _ => by rw [Finset.mul_sum]
    _ = ∑ i ∈ s, ∑ j ∈ s, c j * (c i * osBilin ω (G i) (G j)) := Finset.sum_comm
    _ = ∑ i ∈ s, ∑ j ∈ s, c i * c j * osBilin ω (G i) (G j) := by
          refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
          ring
/-- **Reflection positivity of a real linear combination**: the Gram form is nonnegative on
positive-time observables. -/
theorem osBilin_gram_nonneg (ω : LinearFunctional)
    (hRP : IsReflectionPositiveOn (PositiveTimeAlgebra : Set Observable) ω.toFun)
    {ι : Type*} (s : Finset ι) (c : ι → ℝ) (G : ι → Observable)
    (hG : ∀ i ∈ s, G i ∈ PositiveTimeAlgebra) :
    0 ≤ ∑ i ∈ s, ∑ j ∈ s, c i * c j * osBilin ω (G i) (G j) := by
  rw [osBilin_gram]
  exact hRP _ (Subalgebra.sum_mem _ fun i hi => Subalgebra.smul_mem _ (hG i hi) (c i))

/-! ## The complex quadratic form of a symmetric real matrix -/

/-- **A complex quadratic form with a symmetric real matrix is real**, with real part the sum of
the two real quadratic forms of `Re c` and `Im c`. -/
theorem complex_sum_quadform {ι : Type*} [Fintype ι] (B : ι → ι → ℝ)
    (hB : ∀ i j, B i j = B j i) (c : ι → ℂ) :
    (∑ i, ∑ j, (starRingEnd ℂ) (c i) * c j * (B i j : ℂ)) =
      ((∑ i, ∑ j, (c i).re * (c j).re * B i j) +
        (∑ i, ∑ j, (c i).im * (c j).im * B i j) : ℝ) := by
  have hcancel : (∑ i, ∑ j, (c i).re * (c j).im * B i j) =
      (∑ i, ∑ j, (c i).im * (c j).re * B i j) := by
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
    rw [hB j i]
    ring
  have hre : ∀ i j : ι,
      ((starRingEnd ℂ) (c i) * c j * (B i j : ℂ)).re =
        B i j * ((c i).re * (c j).re + (c i).im * (c j).im) := by
    intro i j
    simp only [Complex.mul_re, Complex.mul_im, Complex.conj_re, Complex.conj_im,
      Complex.ofReal_re, Complex.ofReal_im, mul_zero, sub_zero]
    ring
  have him : ∀ i j : ι,
      ((starRingEnd ℂ) (c i) * c j * (B i j : ℂ)).im =
        B i j * ((c i).re * (c j).im - (c i).im * (c j).re) := by
    intro i j
    simp only [Complex.mul_re, Complex.mul_im, Complex.conj_re, Complex.conj_im,
      Complex.ofReal_re, Complex.ofReal_im, mul_zero]
    ring
  apply Complex.ext
  · -- the real part is the sum of the two real quadratic forms
    simp only [Complex.re_sum, hre, Complex.ofReal_re]
    have hsplit : (∑ i, ∑ j, B i j * ((c i).re * (c j).re + (c i).im * (c j).im)) =
        (∑ i, ∑ j, (c i).re * (c j).re * B i j) +
          ∑ i, ∑ j, (c i).im * (c j).im * B i j := by
      simp only [mul_add, Finset.sum_add_distrib]
      congr 1
      · exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => by ring
      · exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => by ring
    rw [hsplit]
  · -- the imaginary part vanishes by symmetry of `B`
    simp only [Complex.im_sum, him, Complex.ofReal_im]
    have hsplit : (∑ i, ∑ j, B i j * ((c i).re * (c j).im - (c i).im * (c j).re)) =
        (∑ i, ∑ j, (c i).re * (c j).im * B i j) -
          ∑ i, ∑ j, (c i).im * (c j).re * B i j := by
      simp only [mul_sub, Finset.sum_sub_distrib]
      congr 1
      · exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => by ring
      · exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => by ring
    rw [hsplit, hcancel, sub_self]

/-! ## The two directions of the dictionary -/

/-- **The platform's reflection positivity from state-level OS positivity.**

Let `Wobs : Loop d → Observable` send a loop to its observable, with `θ (Wobs γ) = Wobs (γᶠ`) the
reflected loop, and suppose the product observable of every family of strictly positive-time
loops lies in the positive-time algebra `𝔄₊`.  If `ω` is reflection positive on `𝔄₊`, then the
correlation functional `A ↦ ω(∏_{γ ∈ A} Wobs γ)` is reflection positive in the sense of
`YangMills.IsReflectionPositive`. -/
theorem isReflectionPositive_yangMills (ω : LinearFunctional)
    (hRP : IsReflectionPositiveOn (PositiveTimeAlgebra : Set Observable) ω.toFun)
    (Wobs : YangMills.Loop d → Observable)
    (hθ : ∀ γ : YangMills.Loop d, thetaObs (Wobs γ) = Wobs γ.reflect)
    (hPT : ∀ A : List (YangMills.Loop d), (∀ γ ∈ A, γ.StrictlyPositiveTime) →
      loopProd Wobs A ∈ PositiveTimeAlgebra) :
    YangMills.IsReflectionPositive fun A => (ω.toFun (loopProd Wobs A) : ℂ) := by
  intro n c A hA
  have hG : ∀ i : Fin n, loopProd Wobs (A i) ∈ PositiveTimeAlgebra :=
    fun i => hPT (A i) fun γ hγ => (hA i).2 γ hγ
  have hterm : ∀ i j : Fin n,
      (ω.toFun (loopProd Wobs ((A i).map YangMills.Loop.reflect ++ A j)) : ℂ) =
        (osBilin ω (loopProd Wobs (A i)) (loopProd Wobs (A j)) : ℂ) := by
    intro i j
    rw [loopProd_append, ← thetaObs_loopProd Wobs hθ (A i)]
    rfl
  have hsym : ∀ i j : Fin n,
      osBilin ω (loopProd Wobs (A i)) (loopProd Wobs (A j)) =
        osBilin ω (loopProd Wobs (A j)) (loopProd Wobs (A i)) :=
    fun i j => osForm_symm' ω _ _
  simp only [hterm]
  rw [complex_sum_quadform (fun i j => osBilin ω (loopProd Wobs (A i)) (loopProd Wobs (A j)))
    hsym c]
  constructor
  · simp
  · have h1 := osBilin_gram_nonneg ω hRP Finset.univ (fun i => (c i).re)
      (fun i => loopProd Wobs (A i)) fun i _ => hG i
    have h2 := osBilin_gram_nonneg ω hRP Finset.univ (fun i => (c i).im)
      (fun i => loopProd Wobs (A i)) fun i _ => hG i
    simpa using add_nonneg h1 h2

/-- **The converse, for a single family**: if the correlation functional is reflection positive in
the platform's sense, then the OS form is nonnegative on the product observable of every family of
strictly positive-time loops. -/
theorem isReflectionPositiveOn_loopProd (ω : LinearFunctional)
    (Wobs : YangMills.Loop d → Observable)
    (hθ : ∀ γ : YangMills.Loop d, thetaObs (Wobs γ) = Wobs γ.reflect)
    (hRP : YangMills.IsReflectionPositive fun A => (ω.toFun (loopProd Wobs A) : ℂ))
    (A : List (YangMills.Loop d)) (hAdm : YangMills.IsAdmissible A)
    (hA : ∀ γ ∈ A, γ.StrictlyPositiveTime) :
    0 ≤ osBilin ω (loopProd Wobs A) (loopProd Wobs A) := by
  have h := (hRP 1 (fun _ => 1) (fun _ => A) (fun _ => ⟨hAdm, hA⟩)).2
  have h1 : (ω.toFun (loopProd Wobs (A.map YangMills.Loop.reflect ++ A)) : ℂ) =
      (osBilin ω (loopProd Wobs A) (loopProd Wobs A) : ℂ) := by
    rw [loopProd_append, ← thetaObs_loopProd Wobs hθ A]
    rfl
  simpa [Fin.sum_univ_one, h1] using h

end

end BookProof.OSReconstruction
