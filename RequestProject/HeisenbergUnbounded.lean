module

public import RequestProject.UnitaryGroup
public import RequestProject.SelfAdjointResolvent

/-!
# Heisenberg invariance of number-preserving observables for unbounded `H` and `N`

This redoes `heisenberg_shift_invariant` (`ArtificialGap.lean`, bounded operators) for
unbounded operators, using the unitary groups `exp(itH)` of `UnitaryGroup.lean`.

Setting:
* `H` is self-adjoint and bounded below, given with its resolvent `R = (H - σ)⁻¹`
  (`IsSemibounded H m σ R`);
* `N` is a closed operator whose eigenvectors span a dense subspace (a number operator);
* `[H, N] = 0` in the standard sense for unbounded operators: the resolvent `R` of `H` commutes
  with `N` (`R` maps `D(N)` into `D(N)` and `N R = R N` there);
* `Hμ = H + μN` on `D(H) ∩ D(N)`, and `Hμ` is symmetric;
* `O` is a bounded observable with `[O, N] = 0` (`O` maps `D(N)` into `D(N)`, `N O = O N`).

Then for every unitary group `U` generated by `H` and `Uμ` generated by `Hμ` (in the sense of
the Schrödinger equation, `IsUnitaryGroupOf`):
`Uμ t * O * Uμ (-t) = U t * O * U (-t)`.
-/

@[expose] public section

open scoped InnerProductSpace

noncomputable section

namespace CftCheck

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]

/-! ### Eigenspaces of an unbounded operator -/

/-- The eigenspace `{v ∈ D(N) | N v = n v}` of a partially defined operator `N`. -/
def eigenspaceN (N : E →ₗ.[ℂ] E) (n : ℂ) : Submodule ℂ E where
  carrier := {v | ∃ h : v ∈ N.domain, N ⟨v, h⟩ = n • v}
  add_mem' := by
    rintro a b ⟨ha, ha'⟩ ⟨hb, hb'⟩
    refine ⟨N.domain.add_mem ha hb, ?_⟩
    have : (⟨a + b, N.domain.add_mem ha hb⟩ : N.domain) = ⟨a, ha⟩ + ⟨b, hb⟩ := rfl
    rw [this, LinearPMap.map_add, ha', hb', smul_add]
  zero_mem' := ⟨N.domain.zero_mem, by
    have : (⟨0, N.domain.zero_mem⟩ : N.domain) = 0 := rfl
    rw [this, LinearPMap.map_zero, smul_zero]⟩
  smul_mem' := by
    rintro c a ⟨ha, ha'⟩
    refine ⟨N.domain.smul_mem c ha, ?_⟩
    have : (⟨c • a, N.domain.smul_mem c ha⟩ : N.domain) = c • ⟨a, ha⟩ := rfl
    rw [this, LinearPMap.map_smul, ha', smul_comm]

omit [CompleteSpace E] in
theorem mem_eigenspaceN {N : E →ₗ.[ℂ] E} {n : ℂ} {v : E} :
    v ∈ eigenspaceN N n ↔ ∃ h : v ∈ N.domain, N ⟨v, h⟩ = n • v := Iff.rfl

omit [CompleteSpace E] in
/-- Eigenspaces of a closed operator are closed. -/
theorem isClosed_eigenspaceN {N : E →ₗ.[ℂ] E} (hN : N.IsClosed) (n : ℂ) :
    IsClosed (eigenspaceN N n : Set E) := by
  have hc : Continuous (fun v : E => (v, n • v)) := continuous_id.prodMk (continuous_const_smul n)
  have : (eigenspaceN N n : Set E) = (fun v : E => (v, n • v)) ⁻¹' (N.graph : Set (E × E)) := by
    ext v
    simp only [Set.mem_preimage, SetLike.mem_coe, LinearPMap.mem_graph_iff]
    constructor
    · rintro ⟨h, hv⟩; exact ⟨⟨v, h⟩, rfl, hv⟩
    · rintro ⟨y, hy1, hy2⟩
      refine ⟨hy1 ▸ y.2, ?_⟩
      have : (⟨v, hy1 ▸ y.2⟩ : N.domain) = y := Subtype.ext hy1.symm
      rw [this, hy2]
  rw [this]; exact hN.preimage hc

omit [CompleteSpace E] in
/-- A bounded operator commuting with `N` preserves the eigenspaces of `N`. -/
theorem eigenspaceN_invariant {N : E →ₗ.[ℂ] E} {B : E →L[ℂ] E}
    (hB : ∀ x : N.domain, ∃ h : B x ∈ N.domain, N ⟨B x, h⟩ = B (N x)) (n : ℂ) :
    ∀ v ∈ eigenspaceN N n, B v ∈ eigenspaceN N n := by
  rintro v ⟨hv, hNv⟩
  obtain ⟨h, h'⟩ := hB ⟨v, hv⟩
  exact ⟨h, h'.trans (by rw [hNv, map_smul])⟩

variable {H : E →ₗ.[ℂ] E} {m σ : ℝ} {R : E →L[ℂ] E}

/-- The image under the resolvent of a closed invariant subspace `V` is dense in `V`. -/
theorem mem_closure_R_image (hH : IsSemibounded H m σ R) (V : Submodule ℂ E)
    (hV : IsClosed (V : Set E)) (hRV : ∀ v ∈ V, R v ∈ V) {v : E} (hv : v ∈ V) :
    v ∈ closure (R '' V) := by
  set K := (V.map (R : E →ₗ[ℂ] E)).topologicalClosure with hK
  have hKset : (K : Set E) = closure (R '' V) := by
    rw [hK, Submodule.topologicalClosure_coe, Submodule.map_coe]; rfl
  have hKV : K ≤ V := Submodule.topologicalClosure_minimal _
    (by rintro _ ⟨w, hw, rfl⟩; exact hRV w hw) hV
  rw [← hKset]
  obtain ⟨p, hp, q, hq, rfl⟩ := K.exists_add_mem_mem_orthogonal v
  have hqV : q ∈ V := by
    have := V.sub_mem hv (hKV hp); simpa using this
  have hsym := ContinuousLinearMap.isSelfAdjoint_iff_isSymmetric.mp hH.isSelfAdjoint_R
  have hRq : R q = 0 := by
    have h1 : ⟪R (R q), q⟫_ℂ = 0 :=
      (Submodule.mem_orthogonal K q).mp hq _
        ((V.map (R : E →ₗ[ℂ] E)).le_topologicalClosure (Submodule.mem_map_of_mem (hRV q hqV)))
    have h2 := hsym (R q) q
    simp only [ContinuousLinearMap.coe_coe] at h2
    rw [h2] at h1
    exact inner_self_eq_zero.mp h1
  have : q = 0 := hH.R_injective (by rw [hRq, map_zero])
  rw [this, add_zero]; exact hp

/-! ### The shifted dynamics on an eigenspace of `N` -/

/-- The phase `exp(itμn)` produced by the shift `μN` on the sector `N = n`. -/
def shiftPhase (μ n t : ℝ) : ℂ := Complex.exp (Complex.I * ((t * (μ * n) : ℝ) : ℂ))

theorem hasDerivAt_shiftPhase (μ n t : ℝ) :
    HasDerivAt (shiftPhase μ n) (shiftPhase μ n t * (Complex.I * ((μ * n : ℝ) : ℂ))) t := by
  have h1 : HasDerivAt (fun s : ℝ => Complex.I * ((s * (μ * n) : ℝ) : ℂ))
      (Complex.I * ((μ * n : ℝ) : ℂ)) t := by
    have := ((hasDerivAt_id t).mul_const (μ * n)).ofReal_comp.const_mul Complex.I
    simpa using this
  exact h1.cexp

theorem shiftPhase_neg_mul (μ n t : ℝ) : shiftPhase μ n (-t) * shiftPhase μ n t = 1 := by
  rw [shiftPhase, shiftPhase, ← Complex.exp_add, ← Complex.exp_zero]
  congr 1; push_cast; ring

/-- **On a sector of fixed `N = n` the shift is a phase (unbounded version).** For `v` in the
eigenspace `N = n`, `exp(it(H + μN)) v = e^{itμn} exp(itH) v`, for every unitary group `Uμ`
generated by `Hμ = H + μN`. -/
theorem sector_dynamics (N Hμ : E →ₗ.[ℂ] E) (μ : ℝ) (hH : IsSemibounded H m σ R)
    (hsymmμ : ∀ x y : Hμ.domain, ⟪Hμ x, (y : E)⟫_ℂ = ⟪(x : E), Hμ y⟫_ℂ)
    (hdom : ∀ y : E, y ∈ H.domain → y ∈ N.domain → y ∈ Hμ.domain)
    (hsum : ∀ (y : E) (hH : y ∈ H.domain) (hN : y ∈ N.domain),
      Hμ ⟨y, hdom y hH hN⟩ = H ⟨y, hH⟩ + (μ : ℂ) • N ⟨y, hN⟩)
    (hNcl : N.IsClosed) (hRN : ∀ x : N.domain, ∃ h : R x ∈ N.domain, N ⟨R x, h⟩ = R (N x))
    {Uμ : ℝ → E →L[ℂ] E} (hUμ : IsUnitaryGroupOf Hμ Uμ) (n : ℝ) {v : E}
    (hv : v ∈ eigenspaceN N n) (t : ℝ) :
    Uμ t v = shiftPhase μ n t • unitaryGroup σ R t v := by
  set V := eigenspaceN N n with hVdef
  have hVc : IsClosed (V : Set E) := isClosed_eigenspaceN hNcl n
  have hRV : ∀ w ∈ V, R w ∈ V := eigenspaceN_invariant hRN n
  -- the claim on the dense subset `R V` of `V`
  have hA : ∀ w ∈ V, ∀ s, Uμ s (R w) = shiftPhase μ n s • unitaryGroup σ R s (R w) := by
    intro w hw s
    set x := R w with hx
    have hxH : x ∈ H.domain := hH.inv.mem_domain w
    have hxV : x ∈ V := hRV w hw
    have hsolH := (unitaryGroup_isUnitaryGroupOf hH).sol ⟨x, hxH⟩
    have hUV : ∀ s, unitaryGroup σ R s x ∈ V := fun s => unitaryGroup_apply_mem hH s V hVc hRV hxV
    have hmemH : ∀ s, shiftPhase μ n s • unitaryGroup σ R s x ∈ H.domain :=
      fun s => H.domain.smul_mem _ (hsolH.mem s)
    have hmemN : ∀ s, shiftPhase μ n s • unitaryGroup σ R s x ∈ N.domain :=
      fun s => N.domain.smul_mem _ (hUV s).1
    have hsol : IsSchrodingerSolution Hμ (fun s => shiftPhase μ n s • unitaryGroup σ R s x) := by
      refine ⟨fun s => hdom _ (hmemH s) (hmemN s), fun s => ?_⟩
      have hd := (hasDerivAt_shiftPhase μ n s).smul (hsolH.deriv s)
      convert hd using 1
      rw [hsum _ (hmemH s) (hmemN s)]
      have eH : (⟨shiftPhase μ n s • unitaryGroup σ R s x, hmemH s⟩ : H.domain)
          = shiftPhase μ n s • (⟨unitaryGroup σ R s x, hsolH.mem s⟩ : H.domain) := rfl
      have eN : (⟨shiftPhase μ n s • unitaryGroup σ R s x, hmemN s⟩ : N.domain)
          = shiftPhase μ n s • (⟨unitaryGroup σ R s x, (hUV s).1⟩ : N.domain) := rfl
      rw [eH, eN, LinearPMap.map_smul, LinearPMap.map_smul, (hUV s).2]
      push_cast
      module
    have := IsSchrodingerSolution.unique hsymmμ (hUμ.sol ⟨x, hdom x hxH hxV.1⟩) hsol
      (by simp [hUμ.zero, shiftPhase, unitaryGroup_zero hH]) s
    exact this
  -- extend by continuity to all of `V`
  have hclosed : IsClosed {v : E | ∀ s, Uμ s v = shiftPhase μ n s • unitaryGroup σ R s v} := by
    simp only [Set.ofPred_forall]
    exact isClosed_iInter (fun s => isClosed_eq (Uμ s).continuous
      ((shiftPhase μ n s • unitaryGroup σ R s).continuous))
  have hsub : closure (R '' V) ⊆ {v : E | ∀ s, Uμ s v = shiftPhase μ n s • unitaryGroup σ R s v} :=
    closure_minimal (by rintro _ ⟨w, hw, rfl⟩; exact hA w hw) hclosed
  exact hsub (mem_closure_R_image hH V hVc hRV hv) t

/-! ### Heisenberg invariance -/

/-- **Heisenberg dynamics of a number-preserving observable do not see the shift `μN`
(unbounded `H` and `N`).**

* `H` is self-adjoint and bounded below, with resolvent `R = (H - σ)⁻¹`;
* `N` is closed and its eigenvectors span a dense subspace (a number operator);
* `[H, N] = 0`: the resolvent `R` commutes with `N`;
* `Hμ = H + μN` on `D(H) ∩ D(N)` is symmetric;
* the bounded observable `O` commutes with `N`.

Then for every unitary group `U` generated by `H` and every unitary group `Uμ` generated by `Hμ`,
`Uμ t O Uμ (-t) = U t O U (-t)`, i.e. `e^{it(H+μN)} O e^{-it(H+μN)} = e^{itH} O e^{-itH}`. -/
theorem heisenberg_shift_invariant_unbounded (H N Hμ : E →ₗ.[ℂ] E) (μ : ℝ) {m σ : ℝ}
    {R : E →L[ℂ] E} (hH : IsSemibounded H m σ R)
    (hsymmμ : ∀ x y : Hμ.domain, ⟪Hμ x, (y : E)⟫_ℂ = ⟪(x : E), Hμ y⟫_ℂ)
    (hdom : ∀ y : E, y ∈ H.domain → y ∈ N.domain → y ∈ Hμ.domain)
    (hsum : ∀ (y : E) (hH : y ∈ H.domain) (hN : y ∈ N.domain),
      Hμ ⟨y, hdom y hH hN⟩ = H ⟨y, hH⟩ + (μ : ℂ) • N ⟨y, hN⟩)
    (hNcl : N.IsClosed)
    (hNdense : Dense (Submodule.span ℂ
      {v : E | ∃ n : ℝ, ∃ h : v ∈ N.domain, N ⟨v, h⟩ = (n : ℂ) • v} : Set E))
    (hRN : ∀ x : N.domain, ∃ h : R x ∈ N.domain, N ⟨R x, h⟩ = R (N x))
    (O : E →L[ℂ] E) (hON : ∀ x : N.domain, ∃ h : O x ∈ N.domain, N ⟨O x, h⟩ = O (N x))
    {U Uμ : ℝ → E →L[ℂ] E} (hU : IsUnitaryGroupOf H U) (hUμ : IsUnitaryGroupOf Hμ Uμ) (t : ℝ) :
    Uμ t * O * Uμ (-t) = U t * O * U (-t) := by
  have hUeq : U = unitaryGroup σ R := hU.eq_unitaryGroup hH
  subst hUeq
  refine ContinuousLinearMap.ext (fun x => ?_)
  have hEq : Set.EqOn (⇑(Uμ t * O * Uμ (-t))) (⇑(unitaryGroup σ R t * O * unitaryGroup σ R (-t)))
      {v : E | ∃ n : ℝ, ∃ h : v ∈ N.domain, N ⟨v, h⟩ = (n : ℂ) • v} := by
    rintro v ⟨n, hvN, hv⟩
    have hvV : v ∈ eigenspaceN N n := ⟨hvN, hv⟩
    have hVc := isClosed_eigenspaceN hNcl n
    have hRV : ∀ w ∈ eigenspaceN N n, R w ∈ eigenspaceN N n := eigenspaceN_invariant hRN n
    have hOV : ∀ w ∈ eigenspaceN N n, O w ∈ eigenspaceN N n := eigenspaceN_invariant hON n
    have hw : O (unitaryGroup σ R (-t) v) ∈ eigenspaceN N n :=
      hOV _ (unitaryGroup_apply_mem hH (-t) _ hVc hRV hvV)
    simp only [mul_apply_eq_comp]
    rw [sector_dynamics N Hμ μ hH hsymmμ hdom hsum hNcl hRN hUμ n hvV, map_smul, map_smul,
      sector_dynamics N Hμ μ hH hsymmμ hdom hsum hNcl hRN hUμ n hw, smul_smul,
      shiftPhase_neg_mul, one_smul]
  exact ContinuousLinearMap.eqOn_closure_span hEq (by rw [hNdense.closure_eq]; trivial)

/-! ### Existence of the unitary groups -/

/-- **Existence and uniqueness of the unitary group of a self-adjoint Hamiltonian bounded
below.** If `H† = H` (Mathlib's adjoint of a partially defined operator) and
`Re⟪x, Hx⟫ ≥ m‖x‖²`, there is exactly one family `U t` (`t ∈ ℝ`) of bounded operators with
`U 0 = 1` such that for every `x ∈ D(H)`, `t ↦ U t x` stays in `D(H)` and solves the
Schrödinger equation `dψ/dt = iHψ`. It is a strongly continuous one-parameter group of
isometries with inverse `U (-t)`, i.e. the unitary group `exp(itH)`. -/
theorem unitary_evolution_exists {H : E →ₗ.[ℂ] E} (hH : IsSelfAdjoint H) {m : ℝ}
    (hlow : ∀ x : H.domain, m * ‖(x : E)‖ ^ 2 ≤ RCLike.re ⟪(x : E), H x⟫_ℂ) :
    ∃ U : ℝ → E →L[ℂ] E,
      IsUnitaryGroupOf H U ∧
      (∀ V : ℝ → E →L[ℂ] E, IsUnitaryGroupOf H V → V = U) ∧
      (∀ s t, U (s + t) = U s * U t) ∧
      (∀ t, U t * U (-t) = 1 ∧ U (-t) * U t = 1) ∧
      (∀ t x, ‖U t x‖ = ‖x‖) ∧
      (∀ x, Continuous (fun t => U t x)) := by
  obtain ⟨R, hR⟩ := IsSelfAdjoint.exists_isSemibounded hH hlow (sub_one_lt m)
  exact ⟨unitaryGroup (m - 1) R, unitaryGroup_isUnitaryGroupOf hR,
    fun V hV => hV.eq_unitaryGroup hR, unitaryGroup_add hR,
    fun t => ⟨unitaryGroup_mul_neg hR t, unitaryGroup_neg_mul hR t⟩,
    norm_unitaryGroup_apply hR, continuous_unitaryGroup_apply hR⟩

/-- **Heisenberg invariance with both unitary groups constructed.** In the setting of
`heisenberg_shift_invariant_unbounded`, assume in addition that `Hμ` is self-adjoint and bounded
below. Then the unitary groups `exp(itH)` and `exp(itHμ)` exist (and are unique, by
`unitary_evolution_exists`), and
`exp(itHμ) O exp(-itHμ) = exp(itH) O exp(-itH)` for all `t`. -/
theorem heisenberg_shift_invariant_selfAdjoint (H N Hμ : E →ₗ.[ℂ] E) (μ : ℝ) {m σ : ℝ}
    {R : E →L[ℂ] E} (hH : IsSemibounded H m σ R) (hHμsa : IsSelfAdjoint Hμ) {mμ : ℝ}
    (hHμlow : ∀ x : Hμ.domain, mμ * ‖(x : E)‖ ^ 2 ≤ RCLike.re ⟪(x : E), Hμ x⟫_ℂ)
    (hdom : ∀ y : E, y ∈ H.domain → y ∈ N.domain → y ∈ Hμ.domain)
    (hsum : ∀ (y : E) (hH : y ∈ H.domain) (hN : y ∈ N.domain),
      Hμ ⟨y, hdom y hH hN⟩ = H ⟨y, hH⟩ + (μ : ℂ) • N ⟨y, hN⟩)
    (hNcl : N.IsClosed)
    (hNdense : Dense (Submodule.span ℂ
      {v : E | ∃ n : ℝ, ∃ h : v ∈ N.domain, N ⟨v, h⟩ = (n : ℂ) • v} : Set E))
    (hRN : ∀ x : N.domain, ∃ h : R x ∈ N.domain, N ⟨R x, h⟩ = R (N x))
    (O : E →L[ℂ] E) (hON : ∀ x : N.domain, ∃ h : O x ∈ N.domain, N ⟨O x, h⟩ = O (N x)) :
    ∃ U Uμ : ℝ → E →L[ℂ] E, IsUnitaryGroupOf H U ∧ IsUnitaryGroupOf Hμ Uμ ∧
      ∀ t, Uμ t * O * Uμ (-t) = U t * O * U (-t) := by
  obtain ⟨Rμ, hRμ⟩ := IsSelfAdjoint.exists_isSemibounded hHμsa hHμlow (sub_one_lt mμ)
  exact ⟨unitaryGroup σ R, unitaryGroup (mμ - 1) Rμ, unitaryGroup_isUnitaryGroupOf hH,
    unitaryGroup_isUnitaryGroupOf hRμ, fun t => heisenberg_shift_invariant_unbounded H N Hμ μ hH
      hRμ.symm hdom hsum hNcl hNdense hRN O hON (unitaryGroup_isUnitaryGroupOf hH)
      (unitaryGroup_isUnitaryGroupOf hRμ) t⟩

end CftCheck
