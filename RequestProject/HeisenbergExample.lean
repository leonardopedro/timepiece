module

public import RequestProject.HeisenbergUnbounded
public import RequestProject.UnboundedExample

/-!
# The hypotheses of the unbounded Heisenberg theorem are satisfiable

On `ℓ²(ℕ)` take the unbounded `H = N = diag(k)` (`diagH`, `UnboundedExample.lean`),
`Hμ = (1 + μ) H` (so `Hμ = H + μN`), and the bounded observable `O = diag(1/(k+1))`. All
hypotheses of `heisenberg_shift_invariant_unbounded` hold, with the unitary groups
`U t = exp(itH)` and `Uμ t = exp(i(1+μ)tH)`.
-/

@[expose] public section

open scoped InnerProductSpace

noncomputable section

namespace CftCheck

section General

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]

omit [CompleteSpace E] in
theorem pmapOfShiftInvert_apply' (R : E →L[ℂ] E) (hinj : Function.Injective R) (σ : ℝ)
    (x : (pmapOfShiftInvert R hinj σ).domain) (a : E) (h : (x : E) = R a) :
    pmapOfShiftInvert R hinj σ x = a + (σ : ℂ) • R a := by
  have : x = ⟨R a, mem_domain_pmapOfShiftInvert R hinj σ a⟩ := Subtype.ext h
  rw [this, pmapOfShiftInvert_apply]

omit [CompleteSpace E] in
theorem exists_eq_R_of_mem (R : E →L[ℂ] E) (hinj : Function.Injective R) (σ : ℝ)
    (x : (pmapOfShiftInvert R hinj σ).domain) : ∃ a : E, (x : E) = R a := by
  obtain ⟨a, ha⟩ := x.2
  exact ⟨a, ha.symm⟩

omit [CompleteSpace E] in
/-- `H = R⁻¹ + σ` is a closed operator. -/
theorem pmapOfShiftInvert_isClosed (R : E →L[ℂ] E) (hinj : Function.Injective R) (σ : ℝ) :
    (pmapOfShiftInvert R hinj σ).IsClosed := by
  have : ((pmapOfShiftInvert R hinj σ).graph : Set (E × E))
      = {p : E × E | p.1 = R (p.2 - (σ : ℂ) • p.1)} := by
    ext ⟨x, z⟩
    simp only [SetLike.mem_coe, LinearPMap.mem_graph_iff, Set.mem_ofPred_eq]
    constructor
    · rintro ⟨u, hu1, hu2⟩
      obtain ⟨a, ha⟩ := exists_eq_R_of_mem R hinj σ u
      rw [pmapOfShiftInvert_apply' R hinj σ u a ha] at hu2
      rw [← hu1, ← hu2, ha]
      congr 1
      abel
    · intro h
      have hx : x ∈ (pmapOfShiftInvert R hinj σ).domain :=
        h ▸ mem_domain_pmapOfShiftInvert R hinj σ _
      refine ⟨⟨x, hx⟩, rfl, ?_⟩
      rw [pmapOfShiftInvert_apply' R hinj σ ⟨x, hx⟩ (z - (σ : ℂ) • x) h, ← h]
      abel
  show IsClosed ((pmapOfShiftInvert R hinj σ).graph : Set (E × E))
  rw [this]
  exact isClosed_eq continuous_fst (R.continuous.comp (continuous_snd.sub
    ((continuous_const_smul _).comp continuous_fst)))

omit [CompleteSpace E] in
/-- `R` commutes with `H = R⁻¹ + σ`. -/
theorem pmapOfShiftInvert_R_comm (R : E →L[ℂ] E) (hinj : Function.Injective R) (σ : ℝ)
    (x : (pmapOfShiftInvert R hinj σ).domain) :
    ∃ h : R x ∈ (pmapOfShiftInvert R hinj σ).domain,
      pmapOfShiftInvert R hinj σ ⟨R x, h⟩ = R (pmapOfShiftInvert R hinj σ x) := by
  obtain ⟨a, ha⟩ := exists_eq_R_of_mem R hinj σ x
  refine ⟨mem_domain_pmapOfShiftInvert R hinj σ _, ?_⟩
  rw [pmapOfShiftInvert_apply' R hinj σ _ (x : E) rfl, pmapOfShiftInvert_apply' R hinj σ x a ha,
    map_add, map_smul, ← ha]

end General

/-- `exp(i(1+μ)tH)` is the unitary group generated by `(1+μ)H`. -/
theorem isUnitaryGroupOf_smul {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    {H : E →ₗ.[ℂ] E} {U : ℝ → E →L[ℂ] E} (hU : IsUnitaryGroupOf H U) (c : ℝ) :
    IsUnitaryGroupOf ((c : ℂ) • H) (fun t => U (c * t)) := by
  refine ⟨by simpa using hU.zero, fun x => ⟨fun t => (hU.sol x).mem (c * t), fun t => ?_⟩⟩
  have h1 : HasDerivAt (fun t : ℝ => c * t) c t := by simpa using (hasDerivAt_id t).const_mul c
  have h2 : HasDerivAt (fun s => U (c * s) x)
      (c • Complex.I • H ⟨U (c * t) x, (hU.sol x).mem (c * t)⟩) t :=
    ((hU.sol x).deriv (c * t)).scomp t h1
  refine h2.congr_deriv ?_
  rw [LinearPMap.smul_apply, ← Complex.coe_smul, smul_comm]

/-- The vectors `e_k` are eigenvectors of `diagH = diag(k)`. -/
theorem diagH_single (k : ℕ) :
    ∃ h : (lp.single 2 k 1 : L2) ∈ diagH.domain, diagH ⟨lp.single 2 k 1, h⟩
      = ((k : ℝ) : ℂ) • (lp.single 2 k 1 : L2) := by
  have hRe : diagR (lp.single 2 k ((k : ℂ) + 1)) = lp.single 2 k 1 := by
    ext j
    rw [diagR_apply]
    by_cases hj : j = k
    · subst hj; simp [natCast_add_one_ne_zero j]
    · simp [lp.single_apply, hj]
  have hmem : (lp.single 2 k 1 : L2) ∈ diagH.domain :=
    hRe ▸ mem_domain_pmapOfShiftInvert diagR diagR_injective (-1) _
  refine ⟨hmem, (pmapOfShiftInvert_apply' diagR diagR_injective (-1) ⟨_, hmem⟩ _ hRe.symm).trans ?_⟩
  rw [hRe]
  ext j
  by_cases hj : j = k
  · subst hj; simp
  · simp [lp.single_apply, hj]

/-- The eigenvectors of `diagH` span a dense subspace of `ℓ²(ℕ)`. -/
theorem diagH_eigen_dense : Dense (Submodule.span ℂ
    {v : L2 | ∃ n : ℝ, ∃ h : v ∈ diagH.domain, diagH ⟨v, h⟩ = (n : ℂ) • v} : Set L2) := by
  let b : HilbertBasis ℕ ℂ L2 := ⟨LinearIsometryEquiv.refl ℂ _⟩
  have hb : ∀ k, b k = lp.single 2 k 1 := fun k => by
    rw [← b.repr_symm_single]; rfl
  have hspan : Submodule.span ℂ (Set.range b) ≤ Submodule.span ℂ
      {v : L2 | ∃ n : ℝ, ∃ h : v ∈ diagH.domain, diagH ⟨v, h⟩ = (n : ℂ) • v} := by
    refine Submodule.span_mono ?_
    rintro _ ⟨k, rfl⟩
    rw [hb]
    exact ⟨k, diagH_single k⟩
  rw [Submodule.dense_iff_topologicalClosure_eq_top, eq_top_iff, ← b.dense_span]
  exact Submodule.topologicalClosure_mono hspan

/-- **Non-vacuity of `heisenberg_shift_invariant_unbounded`.** On `ℓ²(ℕ)`, with the unbounded
`H = N = diag(k)`, `Hμ = (1+μ)H`, `O = diag(1/(k+1))`, `U t = exp(itH)` and
`Uμ t = exp(i(1+μ)tH)`, every hypothesis of the theorem holds, and `H` is unbounded. -/
theorem heisenberg_unbounded_example (μ : ℝ) :
    let Hμ : L2 →ₗ.[ℂ] L2 := ((1 + μ : ℝ) : ℂ) • diagH
    IsSemibounded diagH 0 (-1) diagR ∧
    (∀ C : ℝ, ∃ x : diagH.domain, C * ‖(x : L2)‖ < ‖diagH x‖) ∧
    (∀ x y : Hμ.domain, ⟪Hμ x, (y : L2)⟫_ℂ = ⟪(x : L2), Hμ y⟫_ℂ) ∧
    (∃ hdom : ∀ y : L2, y ∈ diagH.domain → y ∈ diagH.domain → y ∈ Hμ.domain,
      ∀ (y : L2) (hH : y ∈ diagH.domain) (hN : y ∈ diagH.domain),
        Hμ ⟨y, hdom y hH hN⟩ = diagH ⟨y, hH⟩ + (μ : ℂ) • diagH ⟨y, hN⟩) ∧
    diagH.IsClosed ∧
    Dense (Submodule.span ℂ
      {v : L2 | ∃ n : ℝ, ∃ h : v ∈ diagH.domain, diagH ⟨v, h⟩ = (n : ℂ) • v} : Set L2) ∧
    (∀ x : diagH.domain, ∃ h : diagR x ∈ diagH.domain, diagH ⟨diagR x, h⟩ = diagR (diagH x)) ∧
    IsUnitaryGroupOf diagH (unitaryGroup (-1) diagR) ∧
    IsUnitaryGroupOf Hμ (fun t => unitaryGroup (-1) diagR ((1 + μ) * t)) := by
  intro Hμ
  have hsa := diagH_isSemibounded
  refine ⟨hsa, diagH_unbounded, fun x y => ?_, ⟨fun y hH _ => hH, fun y hH hN => ?_⟩,
    pmapOfShiftInvert_isClosed _ _ _, diagH_eigen_dense, pmapOfShiftInvert_R_comm _ _ _,
    unitaryGroup_isUnitaryGroupOf hsa, isUnitaryGroupOf_smul (unitaryGroup_isUnitaryGroupOf hsa) _⟩
  · change ⟪((1 + μ : ℝ) : ℂ) • diagH x, (y : L2)⟫_ℂ = ⟪(x : L2), ((1 + μ : ℝ) : ℂ) • diagH y⟫_ℂ
    rw [inner_smul_left, inner_smul_right, Complex.conj_ofReal, hsa.symm x y]
  · change ((1 + μ : ℝ) : ℂ) • diagH ⟨y, hH⟩ = _
    push_cast
    rw [add_smul, one_smul]

/-- The conclusion of `heisenberg_shift_invariant_unbounded` in the example. -/
theorem heisenberg_unbounded_example_conclusion (μ t : ℝ) :
    unitaryGroup (-1) diagR ((1 + μ) * t) * diagR * unitaryGroup (-1) diagR ((1 + μ) * -t)
      = unitaryGroup (-1) diagR t * diagR * unitaryGroup (-1) diagR (-t) := by
  obtain ⟨hsa, -, hsymm, ⟨hdom, hsum⟩, hcl, hdense, hRN, hU, hUμ⟩ := heisenberg_unbounded_example μ
  exact heisenberg_shift_invariant_unbounded diagH diagH _ μ hsa hsymm hdom hsum hcl hdense hRN
    diagR hRN hU hUμ t

end CftCheck
