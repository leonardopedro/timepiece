/prove2me_workspace
/.lake
Hashimoto.md
kopperman.tex
Solovay.tex
lopez99.md
Ottinger.md
repomix-output.xml

# Verso build output (rendered HTML; regenerate with `lake exe book`)
/_out

# Backup of the lake packages cache (regenerate with `lake update`)
/.lake_bk

# Lean build artifacts (regenerate with `lake build`)
*.olean
*.ilean
*.c
*.c.tmp
*.ndjson
*.mmb

# Aeneas/Charon intermediates at the model crate root (the committed
# `.llbc`/`.lean` under unfer_contracts/ are tracked explicitly)
lib.llbc
# Rust build artifacts
unfer_contracts/**/target/

# Python bytecode (scripts/*.py tools; nothing under scripts/ is compiled into the build)
__pycache__/
*.pyc

# scratch backups
Book.lean.bak

# Verbatim prove2.me download inputs (2 GB) consumed by
# scripts/prove2me_convert.py and scripts/prove2me_deps_convert.py. The
# converted Lean modules are the tracked artifacts (`converted/`); the inputs
# are not regeneration outputs, so they are ignored by ownership, not by build.
/Downloads/

# local scratch (experiment files and saved prompt dumps at the repo root)
/Scratch*.lean
/prompts.save

# openai/math snapshot — verbatim Apache-2.0 conversion input (12,472 files,
# copied 2026-10-20; owner decision: untracked. Provenance is rowed in
# ATTRIBUTION.md, the attribution gate scans it on disk, and the conversion
# lane lives in CONSOLIDATED_PLAN.md's 2026-10-20 wave)
/math/
/.freebuff/
/math28/

# Generated documentation index (scripts/doc_index.py). Regenerate with
# `python3 scripts/doc_index.py`; both files are derived from the doc corpus,
# so they conflict on every merge that touches a document and are not tracked.
/DOC_INDEX.md
/state/doc_index.json
