#!/usr/bin/env python3
"""Check that the U5 census in BookProof/Sirk/ChapterWitnessCensus.lean matches the
recorded ../unfer gauge-fixed campaign fixtures (and that every manifest row is
certified_positive:false).  Pure stdlib; drift in either direction is a failure.

Usage: nix-shell -p python3 --run "python3 scripts/check-witness-census"
"""

from __future__ import annotations

import json
import re
import sys
from decimal import Decimal
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
LEAN = ROOT / "BookProof/Sirk/ChapterWitnessCensus.lean"
FIXTURES = ROOT.parent / "unfer/fock_sirk/tests/fixtures/mass_gap_campaign"


def lean_rows() -> dict[tuple[str, int], dict[str, Decimal]]:
    text = LEAN.read_text()
    block = text.split("def campaignRows : Fin 10 → CampaignRow := ![", 1)[1].split("]", 1)[0]
    entries = re.findall(r"\{([^{}]*)\}", block)
    rows: dict[tuple[str, int], dict[str, Decimal]] = {}
    for entry in entries:
        def field(name: str) -> str:
            m = re.search(rf"\b{name}\s*:=\s*([^,\s}}]+)", entry)
            if m is None:
                raise SystemExit(f"[fail] census entry missing field {name}: {entry}")
            return m.group(1)
        key = (field("g"), int(field("m")))
        rows[key] = {k: Decimal(field(k)) for k in ("gap", "lo", "hi", "delta")}
    return rows


def fixture_rows() -> tuple[dict[tuple[str, int], dict[str, Decimal]], int, int]:
    if not FIXTURES.is_dir():
        raise SystemExit(f"[gap] fixtures absent: {FIXTURES}")
    rows: dict[tuple[str, int], dict[str, Decimal]] = {}
    total = 0
    positive = 0
    for path in sorted(FIXTURES.glob("qym_*.ndjson")):
        lines = [json.loads(line) for line in path.read_text().splitlines() if line.strip()]
        meta = next(line for line in lines if line["kind"] == "campaign_metadata")
        gap = next(line for line in lines if line["kind"] == "certified_mass_gap")
        total += 1
        if gap["certified_positive"]:
            positive += 1
        key = (repr(meta["coupling"]).rstrip("0").rstrip(".") or "0",
               int(meta["krylov_order"]))
        key = ("0" if meta["coupling"] == 0 else key[0], key[1])
        rows[key] = {k: Decimal(repr(gap[k])) for k in ("gap", "lo", "hi", "delta")}
    return rows, total, positive


def main() -> int:
    lean = lean_rows()
    fix, total, positive = fixture_rows()
    if len(lean) != 10 or len(fix) != 10:
        print(f"[fail] expected 10 distinct solves, got Lean={len(lean)}, fixtures={len(fix)}")
        return 1
    if lean.keys() != fix.keys():
        print(f"[fail] coupling/order keys differ: Lean={sorted(lean)} fixtures={sorted(fix)}")
        return 1
    for key in sorted(lean):
        for name in ("gap", "lo", "hi", "delta"):
            if lean[key][name] != fix[key][name]:
                print(f"[fail] {key} {name}: Lean={lean[key][name]} fixture={fix[key][name]}")
                return 1
    if total != 20 or positive != 0:
        print(f"[fail] manifest census: {total} rows, {positive} certified_positive")
        return 1
    print(f"[ok] census matches {len(lean)} solves / {total} manifest rows, "
          f"{positive} certified_positive; no drift")
    return 0


if __name__ == "__main__":
    sys.exit(main())
