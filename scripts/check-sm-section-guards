# ---- 17. §64 the deformation-norm repair closes, and its constant is necessary
# §61.2 measured that a deformation norm repairs the estimate.  §64 proves it with explicit constants
# and proves the constant term is *forced*.  Dropping `muPot_no_hom_dom` would make the affine shape
# look like slack; dropping `muPot_dom` would lose the closure.  The "changed Lagrangian" caveat must
# stay with both: the model's own `volPot` is the `mu = 0` member, which remains un-dominated.
MUREP=BookProof/Ns/ChapterNsVolDomMuRepair.lean
require "$MUREP" "theorem muPot_dom" \
    "§64: gradient domination holds with A = 5/mu + 1, B = mu^2"
require "$MUREP" "theorem muPot_no_hom_dom" \
    "§64: no homogeneous bound exists, so B > 0 is necessary"
require "$MUREP" "theorem muPot_zero" \
    "§64: the repair's mu = 0 member is §61's potential"
pair_require "$MUREP" 'theorem muPot_dom' 'theorem muPot_no_hom_dom' "50" \
    "§64: the closure and the necessity of its constant must stay together"
require "$PLAN" '`B > 0` is necessary, not slack' \
    "§64: the plan must keep the sharpness statement"
require "$PLAN" 'family-level' \
    "§64: the plan must keep the changed-Lagrangian scope"
require "$BOOKPLAN" 'ChapterNsVolDomMuRepair' \
    "§64: the root must import the repair module"

# ---- 18. §65 the structure-constant remainder of {Omega, b}
# §62.3 left the cubic ghost half as an unnamed remainder.  §65 computes it: two contraction channels
# (`cubic_anticomm`), equal by antisymmetry, giving `{Q, b} = 2 * (first-slot trace) * chi beta`.  The
# trace does *not* vanish (`su2Trace_nonzero`), which is what makes "the free complex is not a
# subcomplex" a theorem rather than a slogan; and when it does vanish the corollary upgrades to the full
# charge.  Keeping the trace computation and dropping its non-vanishing witness is the failure mode.
REM=BookProof/Sm/ChapterSmIndexGhostRemainder.lean
require "$REM" "theorem cubic_anticomm" \
    "§65: one antighost leaves two contraction channels"
require "$REM" "theorem Q_anticomm_bGhost" \
    "§65: {Q, b} is twice the first-slot trace"
require "$REM" "theorem brstCharge_anticomm_bGhost" \
    "§65: {Omega, b} is the Gauss sum minus the trace"
require "$REM" "theorem su2Trace_nonzero" \
    "§65: the trace does not vanish for su(2)"
pair_require "$REM" 'theorem Q_anticomm_bGhost' 'theorem brstCharge_anticomm_bGhost' "90" \
    "§65: the ghost half and the full charge must stay together"
require "$PLAN" 'first-slot trace' \
    "§65: the plan must keep the remainder's exact coefficient"
require "$PLAN" 'does not terminate' \
    "§65: the plan must keep the SM-instantiation limitation"
# §65.2 was corrected: the SM-specialized corollary *is* asserted (module §6).  Keeping only the
# "does not terminate" half would leave the plan saying the corollary is missing when it is proved.
require "$REM" "theorem smBrstCharge_anticomm_bGhost" \
    "§65: the SM-specialized corollary must stay asserted"
require "$PLAN" 'is asserted anyway' \
    "§65: the plan must keep the correction (the corollary is proved, not dropped)"
require "$BOOKPLAN" 'ChapterSmIndexGhostRemainder' \
    "§65: the root must import the remainder module"

# ---- 19. §66 the Fourier reconstruction, as far as it is algebraic
# §63 named the gap: the normal-form refutation is a theorem, the passage from `volPot` to `c(εt)²` was
# measurement.  §66 proves the grid half (discrete orthogonality) and the single-mode transfer, and says
# exactly what is still assumed (`hspec`, the Plancherel assembly).  Keeping the transfer without the
# boundary is the failure mode: it would read as if `volPot` had been reconstructed.
REC=BookProof/Ns/ChapterNsVolDomReconstruction.lean
require "$REC" "theorem dft_orthogonal" \
    "§66: a mode the grid cannot resolve averages to nothing"
require "$REC" "theorem volPot_of_single_mode" \
    "§66: a single-mode residual is exactly its coefficient"
require "$REC" "theorem volPot_of_shear_constant" \
    "§66: the constant transfers as c*eps*t"
require "$REC" "theorem volPot_of_shear_constant_normForm" \
    "§66: the penalty is (kappa/2) times the normal form's value"
pair_require "$REC" 'theorem volPot_of_single_mode' 'theorem volPot_of_shear_constant' "80" \
    "§66: the transfer and its shear instance must stay together"
require "$PLAN" 'as far as it is algebraic' \
    "§66: the plan must keep the boundary in the title"
require "$PLAN" 'unitarity of the discrete' \
    "§66: the plan must keep the un-formalized Plancherel step"
require "$BOOKPLAN" 'ChapterNsVolDomReconstruction' \
    "§66: the root must import the reconstruction module"

# ---- 20. §67 the augmented Lagrangian: VolDom discharged, not assumed
# §61 refuted `VolDom` for the model's penalty, leaving `lagGradDom_of_volDom` with an unsatisfiable
# hypothesis.  §67 feeds §64's estimate back in and closes the chain on the augmented Lagrangian with no
# hypothesis.  The scope caveat must stay: this is the two shear coordinates, not `LagNsData`'s `volPot`.
LAG=BookProof/Ns/ChapterNsVolDomMuLagrangian.lean
require "$LAG" "theorem lagGradDom_mu" \
    "§67: gradient domination holds with no hypothesis"
require "$MUREP" "theorem muPot_dom_nonneg" \
    "§67: the comparison needs non-negative constants"
require "$LAG" "theorem one_le_ev2_lagMu" \
    "§67: the Lagrangian is at least 1"
pair_require "$LAG" 'theorem one_le_ev2_lagMu' 'theorem lagGradDom_mu' "90" \
    "§67: the estimate and its coercivity input must stay together"
require "$PLAN" 'discharged rather than assumed' \
    "§67: the plan must keep the verdict"
require "$PLAN" 'not a claim about the three-dimensional model' \
    "§67: the plan must keep the two-coordinate scope"
require "$BOOKPLAN" 'ChapterNsVolDomMuLagrangian' \
    "§67: the root must import the Lagrangian module"

# ---- 21. §68 the Plancherel assembly: hspec derived, not assumed
# §66 assumed that the residual has no nonzero frequency.  §68 inverts the discrete transform on a grid
# and derives it from spatial constancy, so the hypothesis is gone from the new theorems.  The boundary
# must travel with the result: the grid unitarity itself is assumed, and the concrete commensurate
# instantiation is not done.
require "$REC" "theorem coeff_eq_zero_of_grid_vanishing" \
    "§68: the discrete transform must be inverted, not assumed"
require "$REC" "theorem volPot_of_single_mode_of_constant" \
    "§68: the penalty value must be derived from constancy"
require "$REC" "theorem volCoef_eq_zero_of_constant" \
    "§68: the spectrum must be derived, not hypothesised"
pair_require "$REC" 'theorem coeff_eq_zero_of_grid_vanishing' \
    'theorem coeff_eq_zero_of_grid_const' "90" \
    "§68: the inversion and its constant case must stay together"
require "$PLAN" 'derived, not assumed' \
    "§68: the plan must keep the verdict"
require "$PLAN" 'is a statement about the numerical grid' \
    "§68: the plan must keep the residual hypothesis (horth)"

# ---- 22. §69 the constants do not depend on the dimension
# §67 proved the chain in two shear coordinates; a reader may take the estimate for a two-dimensional
# accident.  §69 gives the n-coordinate theorem and the nine-component instance, with the same
# constants — and must keep saying that the model's own volPot is still un-dominated (§61).
require "$LAG" "theorem lagGradDom_family" \
    "§69: the estimate must be stated for every n"
require "$LAG" "theorem lagGradDom_mu_nine" \
    "§69: the nine-component instance must exist"
require "$PLAN" 'constants do not depend on the dimension' \
    "§69: the plan must keep the verdict"
require "$PLAN" 'no gradient domination at all' \
    "§69: the plan must keep §61's obstruction in view"

# ---- 23. §70 the quartet condition and the explicit antighost
# The SM quartet data exists (choice-based); what §70 adds is why the explicit antighost cannot be it:
# Q P Q = Q with P = bGhost is equivalent to a Gauss-sector identity.  The section must not be read as
# proving positivity — that boundary is guarded too.
require "$REM" "theorem bGhost_quartet_iff" \
    "§70: the quartet condition must be reduced to the Gauss-sector identity"
require "$REM" "def traceEnd" \
    "§70: the trace remainder must stay named"
require "$PLAN" 'Nothing in §70 proves positivity' \
    "§70: the plan must keep the honest boundary"
require "$PLAN" 'the trace-corrected Gauss generators' \
    "§70: the plan must keep what the condition says"

if [ "$FAILED" -ne 0 ]; then
    echo
    echo "The sections above pair a result with its boundary.  If a side is genuinely"
    echo "obsolete, change the statement (and this gate) in the same commit — do not"
    echo "delete the caveat to make a check pass."
    exit 1
fi

echo "[OK] SM/BRST section guards: all guarded pairs intact"
