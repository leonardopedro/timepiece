# ---- 8. §55: the obstruction and its converse stay one statement --------------
# The window is overridable so the gate can be exercised negatively
# (`SM_PAIR_WINDOW=10 scripts/check-sm-section-guards` must fail).
PAIR_WINDOW=${SM_PAIR_WINDOW:-80}
pair_require "$PLAN" 'not_gradDom_weylFlat' 'gradDom_weylCoercive_flat' "$PAIR_WINDOW" \
    "§54/§55: the QYM obstruction and the coercive converse must be documented together"
