    "§57 comment block must keep the 'not the SM charge' caveat"

# ---- 11. §58 `VolDom` is false for the actual volume penalty -------------------
# §56 reduced NS gradient domination to `VolDom`, and §58 shows `VolDom` is *false*: the unimodular
# shears make `|grad V|^2/V^2` diverge like `4/eps^2`.  The reduction and the refutation must stay
# together -- keeping `lagGradDom_of_volDom` and dropping the refutation would read the chain as
# merely "open", and keeping the refutation while dropping the reduction loses what it refutes.
VOLDOM=BookProof/Ns/ChapterNsGradDomCoercive.lean
require "$VOLDOM" "theorem lagGradDom_of_volDom" \
    "§58: the reduction to the volume penalty's own estimate"
require "$VOLDOM" "theorem not_gradDom_flatSextic" \
    "§58: sixth-order flatness is not enough either"
require "$VOLDOM" "Correction (§58 of the plan, 2026-11-13)" \
    "§58: the module must record that VolDom is false"
require "scripts/eval-vol-dom.py" "4/eps^2" \
    "§58: the evaluator must state the refuting scaling law"
pair_require "$PLAN" 'the input this section reduces to, `VolDom`, is *false*' \
    'the ratio `4/ε² → ∞`' "$PAIR_WINDOW" \
    "§58: the plan's correction must pair the reduction with its refutation"

# ---- 12. §59 sectors: global hypotheses cannot hold, closed-space ones do ------
