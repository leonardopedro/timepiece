    "§60: the metric pairing is the Fock adjunction"
require "$PLAN" 'No product structure was ever missing' \
    "§60: the plan must keep the correction to item (xii)"
require "$PLAN" 'is **not** the index complex at `n = 12`' \
    "§60: the plan must keep the negative half of the identification"

if [ "$FAILED" -ne 0 ]; then
    echo
    echo "The sections above pair a result with its boundary.  If a side is genuinely"
    echo "obsolete, change the statement (and this gate) in the same commit — do not"
    echo "delete the caveat to make a check pass."
    exit 1
fi

echo "[OK] SM/BRST section guards: all guarded pairs intact"
