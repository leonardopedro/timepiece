    "§56: the reduction of the whole potential to the penalty's own estimate"
require "$NSDOM" "def VolDom" \
    "§56: the remaining input is a named object, not prose"
require "$NSDOM" "theorem not_gradDom_flatSextic" \
    "§56: non-negative degree six is NOT enough (the sextic counterexample)"
pair_require "$PLAN" 'lagGradDom_of_volDom' 'not_gradDom_flatSextic' "$PAIR_WINDOW" \
    "§56: the reduction and the sextic counterexample must stay documented together"
require "$PLAN" 'VolDom' \
    "§56: the plan must keep naming the one open input"
require "$BOOKPLAN" 'not_gradDom_flatSextic' \
    "§56 comment block must keep the sextic counterexample"
require "$BOOKPLAN" 'lagGradDom_of_volDom' \
    "§56 comment block must keep the reduction"

# ---- 10. §57: the index-restricted b-ghost, and its non-vacuity ------------------
# §57 builds the quartet data on `(Fin n × Bool) ⊕ Fin m` and discharges every hypothesis of the
# no-ghost theorem, so its value is exactly the pair "positivity is a theorem" + "the cohomology is
# not trivial".  Dropping `physVec_not_exact` would let the model degenerate into the statement that
# zero is non-negative; dropping `physicalPositivity` loses the construction.  Also keep the plan
# saying that this is *not* `smBrstCharge`.
