#!/usr/bin/env bash
# F7 — GitBook drift check: flag identifiers cited by the test/ GitBook pages
# that no longer exist in the source-of-truth trees.
#
# Two drift surfaces (the GitBook mirrors the project in prose):
#   1. LEAN surface: backtick-quoted identifiers in test/mathematical-foundations|the-program|unfer
#      must resolve in the timepiece Lean tree (word token, *.lean file, or
#      BookProof.X module). A renamed/removed theorem shows up here as a MISS.
#   2. RUST surface: `.rs` suite names cited in test/numerics must resolve in
#      unfer/fock_sirk/tests (the physics validation suites).
#
# Usage:  bash scripts/check-gitbook-drift   (from repo root; ../test and
#         ../unfer are read as siblings, like scripts/verify-invariants).
# Exit 0 = no drift; 1 = at least one stale citation.
set -u

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
GITBOOK="$repo_root/../test"
UNFER_TESTS="$repo_root/../unfer/fock_sirk/tests"

if [[ ! -d "$GITBOOK" ]]; then
    echo "[gap]  ../test GitBook not present — drift check skipped"
    exit 0
fi

# The check body is Python. Without an interpreter this is an unenforced check,
# not detected drift; saying so and exiting 0 keeps a missing tool from reading
# as a stale citation (callers such as scripts/verify-invariants report the
# skip, and a bare invocation here does too). P7 (2026-10-15): uv-managed
# python3 lives outside the default non-login PATH on some machines — the same
# fallback check-all-gates applies — so a direct run on such a box checks
# drift instead of gapping past it.
if ! command -v python3 >/dev/null 2>&1; then
    for candidate in /usr/local/bin/python3 "$HOME/.local/bin/python3"; do
        if [ -x "$candidate" ]; then
            PATH="$(dirname "$candidate"):$PATH"
            export PATH
            break
        fi
    done
fi

if ! command -v python3 >/dev/null 2>&1; then
    echo "[gap]  python3 not on PATH — drift check skipped"
    exit 0
fi

FAILED=0
PASSED=0

echo "=== Lean-surface citations (test/mathematical-foundations, test/the-program, test/unfer) ==="
# Collect every backtick-quoted token that looks like an identifier
# (contains '_' or '.' and is not a filename with a foreign extension).
# Misses listed in scripts/pending-lemmas.txt are documented forward
# references (planned lemmas) and do not fail the gate; everything else
# does. See that file's header for the full contract.
python3 - "$repo_root" "$GITBOOK" "$UNFER_TESTS" "$repo_root/scripts/pending-lemmas.txt" <<'PYEOF'
import re, sys, glob, os

repo_root, gitbook, unfer_tests, pending_path = sys.argv[1:5]

pending = set()
if os.path.isfile(pending_path):
    for line in open(pending_path, encoding="utf-8"):
        line = line.strip()
        if line and not line.startswith("#"):
            pending.add(line)
else:
    print(f"  [warn] {pending_path} missing — every miss is fatal", file=sys.stderr)

lean_files = [
    f for f in glob.glob(os.path.join(repo_root, "**", "*.lean"), recursive=True)
    if "/.lake" not in f and "/.lake_bk" not in f and "/node_modules" not in f
]
lean_tokens = set()
for f in lean_files:
    txt = open(f, encoding="utf-8", errors="replace").read()
    lean_tokens.update(re.findall(r"[A-Za-z_][A-Za-z0-9_]*", txt))
lean_basenames = {os.path.basename(f) for f in lean_files}

# Third surface: the sibling engine code the GitBook cites.  test/unfer pages
# are *about* the unfer Rust engine and the workspace-root reference repos, so
# their identifiers must resolve there; math pages may cite unfer/docs
# artifacts (Cadabra modules, spec docs) but not arbitrary Rust tokens — a
# planned Lean lemma must not be masked by a mention in a .rs comment.
def _tokens(patterns, exclude=()):
    out = set()
    for pat_ in patterns:
        for f in glob.glob(pat_, recursive=True):
            if any(x in f for x in exclude):
                continue
            out.update(re.findall(r"[A-Za-z_][A-Za-z0-9_]*",
                                  open(f, encoding="utf-8", errors="replace").read()))
    return out

unfer_root = os.path.join(repo_root, "..", "unfer")
unfer_tokens = set()
cdb_stems = set()
doc_stems = set()
if os.path.isdir(unfer_root):
    unfer_tokens |= _tokens([os.path.join(unfer_root, "**", "*.rs")], exclude=("/target/",))
    unfer_tokens |= {os.path.splitext(os.path.basename(f))[0]
                     for f in glob.glob(os.path.join(unfer_root, "fock_sirk", "tests", "*.rs"))}
    docs_dir = os.path.join(unfer_root, "docs")
    for f in glob.glob(os.path.join(docs_dir, "*")):
        if os.path.isfile(f):
            stem = os.path.splitext(os.path.basename(f))[0]
            doc_stems.add(stem)
            if f.endswith(".cdb"):
                cdb_stems.add(stem)
    unfer_tokens |= _tokens([os.path.join(docs_dir, "*.cdb"),
                             os.path.join(docs_dir, "*.md")])
    unfer_tokens |= doc_stems

ref_tokens = set()
for _ref in ("AnaCP", "AnaNC"):
    _p = os.path.join(repo_root, "..", _ref)
    if os.path.isdir(_p):
        ref_tokens |= _tokens([os.path.join(_p, "**", "*.py"),
                               os.path.join(_p, "**", "*.md")])

def resolves_sibling(token, relpath):
    """Resolve against sibling source trees, scoped by the citing page."""
    if relpath.startswith("unfer/"):
        return (token in unfer_tokens) or (token in ref_tokens)
    # math/the-program pages: only unfer/docs artifacts (Cadabra/spec) —
    # never the bare Rust token pool, so Lean forward refs stay visible.
    return token in cdb_stems or token in doc_stems

EXTERNAL_EXT = (".rs", ".bin", ".lp", ".json", ".loro", ".md", ".tex", ".toml",
                ".py", ".cdb")
# mathlib / ecosystem names that legitimately live outside this tree
EXTERNAL_HEADS = ("Finset", "Quot", "Metric", "NormedAddCommGroup", "Classical",
                  "Mathlib", "Complex", "Real", "Nat", "Int", "Fin", "green_tsetlin")

def resolves(token):
    if token.endswith(".lean"):
        return token in lean_basenames
    if token.endswith(EXTERNAL_EXT):
        return True  # foreign artifact (rust suite, gitbook page, ...)
    if "." in token:
        head, tail = token.rsplit(".", 1)
        if head in ("BookProof", "Book", "RiemannProof", "PnpProof", "RandomMap") \
                or head.startswith("Chapter"):
            # module-qualified: the tail must be a token in the Lean tree
            return tail in lean_tokens
        if head in EXTERNAL_HEADS:
            return True
        return tail in lean_tokens  # generic qualified name
    return token in lean_tokens

pat = re.compile(r"`([A-Za-z_][A-Za-z0-9_.]*)`")
misses = []
for f in sorted(glob.glob(os.path.join(gitbook, "mathematical-foundations", "*.md"))
                + glob.glob(os.path.join(gitbook, "the-program", "*.md"))
                + glob.glob(os.path.join(gitbook, "unfer", "*.md"))):
    txt = open(f, encoding="utf-8", errors="replace").read()
    for m in pat.finditer(txt):
        t = m.group(1)
        if ("_" in t or "." in t) and not resolves(t) \
                and not resolves_sibling(t, os.path.relpath(f, gitbook)):
            misses.append((t, os.path.relpath(f, gitbook)))

seen = set()
fatal = 0
n_pending = 0
for t, f in sorted(misses):
    if (t, f) in seen:
        continue
    seen.add((t, f))
    if t in pending:
        n_pending += 1
        print(f"  [pending]  {t:<55s} {f}")
    else:
        fatal += 1
        print(f"  [MISS lean] {t:<55s} {f}")

# A pending entry that now resolves in the Lean tree has landed: the entry
# must be removed so the list stays exactly the outstanding surface.
stale = sorted(t for t in pending if resolves(t))
for t in stale:
    print(f"  [stale]    {t:<55s} resolves now — remove from pending-lemmas.txt")

if not misses:
    print("  [ok] all cited Lean identifiers resolve in the tree")
else:
    print(f"  ({n_pending} pending forward reference(s) documented in {os.path.basename(pending_path)}, "
          f"{fatal} unreviewed miss(es))")
sys.exit(1 if fatal else 0)
PYEOF
PY_RC=$?
if [[ "$PY_RC" -ne 0 ]]; then
    FAILED=$((FAILED + 1))
fi

echo
echo "=== Rust-surface citations (test/numerical-physics → unfer/fock_sirk/tests) ==="
if [[ -d "$UNFER_TESTS" ]]; then
    RUST_MISS=0
    RUST_OK=0
    for f in "$GITBOOK"/numerical-physics/*.md; do
        for id in $(grep -oE '`[A-Za-z0-9_]+\.rs`' "$f" 2>/dev/null | tr -d '`' | sort -u); do
            if [[ -f "$UNFER_TESTS/$id" ]]; then
                RUST_OK=$((RUST_OK + 1))
            else
                echo "  [MISS rust] $id ($(basename "$f"))"
                RUST_MISS=$((RUST_MISS + 1))
            fi
        done
    done
    if [[ "$RUST_MISS" -eq 0 ]]; then
        echo "  [ok] all $RUST_OK cited .rs suites resolve in unfer/fock_sirk/tests"
    else
        FAILED=$((FAILED + RUST_MISS))
    fi
else
    echo "  [gap] ../unfer/fock_sirk/tests not present — Rust surface skipped"
fi

echo
echo "check-gitbook-drift: $([ "$FAILED" -eq 0 ] && echo "no drift found" || echo "$FAILED drift item(s)")"
exit "$FAILED"