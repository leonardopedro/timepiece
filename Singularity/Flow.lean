/-!
# S4: Classical Flow Integration

Analyze the classical flow generated by an ODE system.
Returns completeness status and escape events (trajectories that blow up).

## Key definitions

- `FlowAnalysis` — result of classical flow analysis
- `analyzeClassicalFlow` — integrate the ODE and detect blow-up
- `flowComplete_iff_bounded` — flow is complete iff trajectories stay bounded
-/

open Set
open Filter
open Real

/-- A trajectory that blows up: record initial point, blow-up time, divergent axes. -/
structure EscapeEvent (M : ℕ) where
  x0 : Fin M → ℝ
  TBlowup : ℝ
  divergentAxes : List (Fin M)

/-- Result of classical flow analysis for an ODE system. -/
structure FlowAnalysis (M : ℕ) where
  isComplete : Bool
  escapes : List (EscapeEvent M)

/-- Euclidean norm squared of a vector in Fin M → ℝ. -/
def normSq {M : ℕ} (x : Fin M → ℝ) : ℝ :=
  ∑ i, (x i) ^ 2

/-- Compactification radius: trajectories with ||x|| > R_MAX are considered escaped. -/
def R_MAX : ℝ := 1e10

/-- Fixed-step Euler integration for a single time step.
    Given current state x at time t, compute x + dt * f(x). -/
def eulerStep {M : ℕ} (sys : ODESystem M) (dt : ℝ) (x : Fin M → ℝ) : Fin M → ℝ :=
  fun i => x i + dt * (sys.evalRHS x) i

