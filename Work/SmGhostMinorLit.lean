/-- The `55 x 55` minor as a matrix over the field (a missing entry, which cannot occur, is 0). -/
def ghostMinor : Matrix (Fin 55) (Fin 55) Qsqrt3 :=
  fun i j =>
    match ghostMinorData[i.val]? with
    | some row => match row[j.val]? with
      | some p => (ofRat p.1 + sqrt3 * ofRat p.2)
      | none => 0
    | none => 0

/-- The data has 55 rows. -/
theorem ghostMinorData_length : ghostMinorData.length = 55 := by decide

/-- Every row has 55 entries. -/
theorem ghostMinorData_rows : ∀ r ∈ ghostMinorData, r.length = 55 := by decide

/-- The certificate: this minor is nonsingular.  Open in Lean (see the module docstring). -/
def ghostMinorStatement : Prop := certificateStatement ghostMinor

