+theorem qed_field_equations (m e : ℝ) (γ : Fin 4 → Matrix (Fin 4) (Fin 4) ℂ)
+    (hγ : IsDiracRepresentation γ) (A : GaugeField) (ψ : SpinorField)
+    (hA : ContDiff ℝ 2 A) (hψ : ContDiff ℝ 1 ψ)
