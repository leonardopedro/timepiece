+section Prove2meStatement
+
+open MatrixCompletion
+open scoped BigOperators
+
+theorem scalar_centered_sampling_qmoment_bernstein_estimate :
+    ∃ Cbern cbern : ℝ, 0 < Cbern ∧ 0 < cbern ∧
+      ∀ (β : ℝ), 2 < β →
+      ∀ (n₁ n₂ m : ℕ), 0 < n₁ → 0 < n₂ → m ≤ n₁ * n₂ →
+      ∀ (Coeff : Finset (Fin n₁ × Fin n₂) → ℝ)
+        (B : Matrix (Fin n₁) (Fin n₂) ℝ)
+        (entryScale frobScale : ℝ),
+        (∀ Omega : Finset (Fin n₁ × Fin n₂),
+          Coeff Omega =
+            matrixEntrySum
+              (centeredSamplingFluctuation Omega
+                ((m : ℝ) / ((n₁ : ℝ) * (n₂ : ℝ))) B)) →
+        entrySupNorm B ≤ entryScale →
+        frobeniusNorm B ≤ frobScale →
+        ∃ q : ℕ, 1 ≤ q ∧
+          bernoulliExpectation ((m : ℝ) / ((n₁ : ℝ) * (n₂ : ℝ)))
+              (fun Omega => |Coeff Omega| ^ q) ≤
+            (Cbern *
+                (Real.sqrt
+                    ((β * Real.log (↑(max n₁ n₂))) /
+                      ((m : ℝ) / ((n₁ : ℝ) * (n₂ : ℝ)))) *
+                  frobScale +
+                  ((β * Real.log (↑(max n₁ n₂))) /
+                    ((m : ℝ) / ((n₁ : ℝ) * (n₂ : ℝ)))) *
+                  entryScale)) ^ q *
+              (cbern * Real.rpow (↑(max n₁ n₂)) (-β)) := by
+  first
+  | exact _root_.Prove2me.Solution.scalar_centered_sampling_qmoment_bernstein_estimate
+  | (apply _root_.Prove2me.Solution.scalar_centered_sampling_qmoment_bernstein_estimate <;> assumption)
+
+
+end Prove2meStatement
